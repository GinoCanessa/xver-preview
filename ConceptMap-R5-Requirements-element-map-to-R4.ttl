         fhir:code [ fhir:v "Basic.identifier" ] ;
         fhir:display [ fhir:v "Basic.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element matches Basic element path `Basic.identifier` (`Basic.identifier`), use that element instead.\nElement `Requirements.identifier` is not mapped to FHIR R4, since FHIR R5 `Requirements` is not mapped.\nElement `Requirements.identifier` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element)." ]
       ] )
     ] )
