       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.date" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Requirements.date` is not mapped to FHIR R4, since FHIR R5 `Requirements` is not mapped.\nElement `Requirements.date` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nNote that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the Requirements. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
