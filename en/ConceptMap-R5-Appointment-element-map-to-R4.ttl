       fhir:target ( [
         fhir:code [ fhir:v "Appointment.priority" ] ;
         fhir:display [ fhir:v "Appointment.priority" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Appointment.priority` is mapped to FHIR R4 element `Appointment.priority` as `SourceIsBroaderThanTarget`.\nThe mappings for `Appointment.priority` do not cover the following types: CodeableConcept.\nThe mappings for `Appointment.priority` do not cover the following types based on type expansion: coding, text.\nSeeking implementer feedback on this property and how interoperable it is.\r\rUsing an extension to record a CodeableConcept for named values may be tested at a future connectathon." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.description" ] ;
