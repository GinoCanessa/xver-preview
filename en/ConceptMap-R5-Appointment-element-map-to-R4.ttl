       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.meta" ] ;
         fhir:display [ fhir:v "Appointment.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.meta` is mapped to FHIR R4 element `Appointment.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.implicitRules" ] ;
         fhir:display [ fhir:v "Appointment.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.implicitRules` is mapped to FHIR R4 element `Appointment.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.language" ] ;
         fhir:display [ fhir:v "Appointment.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.language` is mapped to FHIR R4 element `Appointment.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.text" ] ;
         fhir:display [ fhir:v "Appointment.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.text` is mapped to FHIR R4 element `Appointment.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.contained" ] ;
         fhir:display [ fhir:v "Appointment.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.contained` is mapped to FHIR R4 element `Appointment.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.identifier" ] ;
         fhir:display [ fhir:v "Appointment.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.identifier` is mapped to FHIR R4 element `Appointment.identifier` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.status" ] ;
         fhir:display [ fhir:v "Appointment.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.status` is mapped to FHIR R4 element `Appointment.status` as `Equivalent`.\nIf the Appointment's status is \"cancelled\" then all participants are expected to have their calendars released for the appointment period, and as such any Slots that were marked as BUSY can be re-set to FREE.\n\nThis element is labeled as a modifier because the status contains the code entered-in-error that mark the Appointment as not currently valid." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.cancellationReason" ] ;
       fhir:display [ fhir:v "cancellationReason" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.cancelationReason" ] ;
         fhir:display [ fhir:v "Appointment.cancelationReason" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.cancellationReason` is mapped to FHIR R4 element `Appointment.cancelationReason` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.serviceCategory" ] ;
       fhir:display [ fhir:v "serviceCategory" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.serviceCategory" ] ;
         fhir:display [ fhir:v "Appointment.serviceCategory" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Appointment.serviceCategory` is mapped to FHIR R4 element `Appointment.serviceCategory` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.serviceType" ] ;
       fhir:display [ fhir:v "serviceType" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Appointment.serviceType" ] ;
         fhir:display [ fhir:v "Appointment.serviceType" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Appointment.serviceType` is mapped to FHIR R4 element `Appointment.serviceType` as `SourceIsBroaderThanTarget`.\nThe mappings for `Appointment.serviceType` do not cover the following types: CodeableReference.\nThe mappings for `Appointment.serviceType` do not cover the following types based on type expansion: reference.\nFor a provider to provider appointment the code \"FOLLOWUP\" may be appropriate, as this is expected to be discussing some patient that was seen in the past." ]
       ] )
     ] [
       fhir:code [ fhir:v "Appointment.specialty" ] ;
