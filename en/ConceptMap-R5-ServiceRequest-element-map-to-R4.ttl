  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/ServiceRequest"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/ServiceRequest>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/ServiceRequest"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/ServiceRequest>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "ServiceRequest.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.meta" ] ;
         fhir:display [ fhir:v "ServiceRequest.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.meta` is mapped to FHIR R4 element `ServiceRequest.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.implicitRules" ] ;
         fhir:display [ fhir:v "ServiceRequest.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.implicitRules` is mapped to FHIR R4 element `ServiceRequest.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.language" ] ;
         fhir:display [ fhir:v "ServiceRequest.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.language` is mapped to FHIR R4 element `ServiceRequest.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.text" ] ;
         fhir:display [ fhir:v "ServiceRequest.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.text` is mapped to FHIR R4 element `ServiceRequest.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.contained" ] ;
         fhir:display [ fhir:v "ServiceRequest.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.contained` is mapped to FHIR R4 element `ServiceRequest.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.identifier" ] ;
         fhir:display [ fhir:v "ServiceRequest.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.identifier` is mapped to FHIR R4 element `ServiceRequest.identifier` as `Equivalent`.\nThe identifier.type element is used to distinguish between the identifiers assigned by the orderer (known as the 'Placer' in HL7 V2) and the producer of the observations in response to the order (known as the 'Filler' in HL7 V2).  For further discussion and examples see the resource notes section below." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.instantiatesCanonical" ] ;
       fhir:display [ fhir:v "instantiatesCanonical" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.instantiatesCanonical" ] ;
         fhir:display [ fhir:v "ServiceRequest.instantiatesCanonical" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.instantiatesCanonical` is mapped to FHIR R4 element `ServiceRequest.instantiatesCanonical` as `Equivalent`.\nThe PlanDefinition resource is used to describe series, sequences, or groups of actions to be taken, while the ActivityDefinition resource is used to define each specific step or activity to be performed. More information can be found in the [Boundaries and Relationships](https://hl7.org/fhir/plandefi.html#12.23.2) section for PlanDefinition." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.instantiatesUri" ] ;
       fhir:display [ fhir:v "instantiatesUri" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.instantiatesUri" ] ;
         fhir:display [ fhir:v "ServiceRequest.instantiatesUri" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.instantiatesUri` is mapped to FHIR R4 element `ServiceRequest.instantiatesUri` as `Equivalent`.\nThis might be an HTML page, PDF, etc. or could just be a non-resolvable URI identifier." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.basedOn" ] ;
       fhir:display [ fhir:v "basedOn" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.basedOn" ] ;
         fhir:display [ fhir:v "ServiceRequest.basedOn" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.basedOn` is mapped to FHIR R4 element `ServiceRequest.basedOn` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.replaces" ] ;
       fhir:display [ fhir:v "replaces" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.replaces" ] ;
         fhir:display [ fhir:v "ServiceRequest.replaces" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.replaces` is mapped to FHIR R4 element `ServiceRequest.replaces` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.requisition" ] ;
       fhir:display [ fhir:v "requisition" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.requisition" ] ;
         fhir:display [ fhir:v "ServiceRequest.requisition" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.requisition` is mapped to FHIR R4 element `ServiceRequest.requisition` as `Equivalent`.\nRequests are linked either by a \"basedOn\" relationship (i.e. one request is fulfilling another) or by having a common requisition. Requests that are part of the same requisition are generally treated independently from the perspective of changing their state or maintaining them after initial creation." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.status" ] ;
         fhir:display [ fhir:v "ServiceRequest.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.status` is mapped to FHIR R4 element `ServiceRequest.status` as `Equivalent`.\nThe status is generally fully in the control of the requester - they determine whether the order is draft or active and, after it has been activated, competed, revoked or placed on-hold. States relating to the activities of the performer are reflected on either the corresponding event (see [Event Pattern](https://hl7.org/fhir/event.html) for general discussion) or using the [Task](https://hl7.org/fhir/task.html) resource." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.intent" ] ;
       fhir:display [ fhir:v "intent" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.intent" ] ;
         fhir:display [ fhir:v "ServiceRequest.intent" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ServiceRequest.intent` is mapped to FHIR R4 element `ServiceRequest.intent` as `Equivalent`.\nThis element is labeled as a modifier because the intent alters when and how the resource is actually applicable." ]
       ] )
     ] [
       fhir:code [ fhir:v "ServiceRequest.category" ] ;
       fhir:display [ fhir:v "category" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ServiceRequest.category" ] ;
