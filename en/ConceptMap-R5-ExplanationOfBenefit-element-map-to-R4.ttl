         fhir:display [ fhir:v "ExplanationOfBenefit.insurance.focal" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ExplanationOfBenefit.insurance.focal` is mapped to FHIR R4 element `ExplanationOfBenefit.insurance.focal` as `Equivalent`.\nA patient may (will) have multiple insurance policies which provide reimbursement for healthcare services and products. For example, a person may also be covered by their spouse's policy and both appear in the list (and may be from the same insurer). This flag will be set to true for only one of the listed policies and that policy will be used for adjudicating this claim. Other claims would be created to request adjudication against the other listed policies." ]
       ] )
