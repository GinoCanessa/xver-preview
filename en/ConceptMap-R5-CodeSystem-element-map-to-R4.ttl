  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "R5CodeSystemElementMapToR4"] ; # 
  fhir:title [ fhir:v "Cross-version mapping for FHIR R5 CodeSystem to FHIR R4 CodeSystem"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2026-03-04T17:07:47.3666362-06:00"^^xsd:dateTime] ; # 
