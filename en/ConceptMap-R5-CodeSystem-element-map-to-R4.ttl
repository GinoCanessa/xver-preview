  fhir:source [
     a fhir:Canonical ;
     fhir:v "http://hl7.org/fhir/5.0"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/5.0>
  ] ; # 
  fhir:target [
     a fhir:Uri ;
     fhir:v "http://hl7.org/fhir/4.0"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/4.0>
  ] ; # 
  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/CodeSystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/CodeSystem>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/CodeSystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/CodeSystem>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "CodeSystem.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.meta" ] ;
         fhir:display [ fhir:v "CodeSystem.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.meta` is mapped to FHIR R4 element `CodeSystem.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.implicitRules" ] ;
         fhir:display [ fhir:v "CodeSystem.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.implicitRules` is mapped to FHIR R4 element `CodeSystem.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.language" ] ;
         fhir:display [ fhir:v "CodeSystem.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.language` is mapped to FHIR R4 element `CodeSystem.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.text" ] ;
         fhir:display [ fhir:v "CodeSystem.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.text` is mapped to FHIR R4 element `CodeSystem.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.contained" ] ;
         fhir:display [ fhir:v "CodeSystem.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.contained` is mapped to FHIR R4 element `CodeSystem.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.url" ] ;
       fhir:display [ fhir:v "url" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.url" ] ;
         fhir:display [ fhir:v "CodeSystem.url" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.url` is mapped to FHIR R4 element `CodeSystem.url` as `Equivalent`.\nCan be a urn:uuid: or a urn:oid: but real http: addresses are preferred.  Multiple instances may share the same URL if they have a distinct version.\n\nThe determination of when to create a new version of a resource (same url, new version) vs. defining a new artifact is up to the author.  Considerations for making this decision are found in [Technical and Business Versions](https://hl7.org/fhir/resource..html#versions). \n\nIn some cases, the resource can no longer be found at the stated url, but the url itself cannot change. Implementations can use the [meta.source](https://hl7.org/fhir/resou.html#meta) element to indicate where the current master source of the resource can be found." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.identifier" ] ;
         fhir:display [ fhir:v "CodeSystem.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.identifier` is mapped to FHIR R4 element `CodeSystem.identifier` as `Equivalent`.\nTypically, this is used for identifiers that can go in an HL7 V3 II (instance identifier) data type, and can then identify this code system outside of FHIR, where it is not possible to use the logical URI.  Note that HL7 defines at least three identifiers for many of its code systems - the FHIR canonical URL, the OID and the V2 Table 0396 mnemonic code." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.version" ] ;
       fhir:display [ fhir:v "version" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.version" ] ;
         fhir:display [ fhir:v "CodeSystem.version" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.version` is mapped to FHIR R4 element `CodeSystem.version` as `Equivalent`.\nThere may be different code system instances that have the same identifier but different versions.  The version can be appended to the url in a reference to allow a reference to a particular business version of the code system with the format [url]|[version]. The version SHOULD NOT contain a '#' - see [Business Version](https://hl7.org/fhir/resource.h.html#bv-format)." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.name" ] ;
       fhir:display [ fhir:v "name" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.name" ] ;
         fhir:display [ fhir:v "CodeSystem.name" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.name` is mapped to FHIR R4 element `CodeSystem.name` as `Equivalent`.\nThe name is not expected to be globally unique. The name should be a simple alphanumeric type name to ensure that it is machine-processing friendly." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.title" ] ;
       fhir:display [ fhir:v "title" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.title" ] ;
         fhir:display [ fhir:v "CodeSystem.title" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.title` is mapped to FHIR R4 element `CodeSystem.title` as `Equivalent`.\nThis name does not need to be machine-processing friendly and may contain punctuation, white-space, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.status" ] ;
         fhir:display [ fhir:v "CodeSystem.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.status` is mapped to FHIR R4 element `CodeSystem.status` as `Equivalent`.\nAllows filtering of code systems that are appropriate for use versus not.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.experimental" ] ;
       fhir:display [ fhir:v "experimental" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.experimental" ] ;
         fhir:display [ fhir:v "CodeSystem.experimental" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.experimental` is mapped to FHIR R4 element `CodeSystem.experimental` as `Equivalent`.\nAllows filtering of code systems that are appropriate for use versus not." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.date" ] ;
       fhir:display [ fhir:v "date" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.date" ] ;
         fhir:display [ fhir:v "CodeSystem.date" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.date` is mapped to FHIR R4 element `CodeSystem.date` as `Equivalent`.\nThe date is often not tracked until the resource is published, but may be present on draft content. Note that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the code system. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.publisher" ] ;
       fhir:display [ fhir:v "publisher" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.publisher" ] ;
         fhir:display [ fhir:v "CodeSystem.publisher" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.publisher` is mapped to FHIR R4 element `CodeSystem.publisher` as `Equivalent`.\nUsually an organization but may be an individual. The publisher (or steward) of the code system is the organization or individual primarily responsible for the maintenance and upkeep of the code system. This is not necessarily the same individual or organization that developed and initially authored the content. The publisher is the primary point of contact for questions or issues with the code system. This item SHOULD be populated unless the information is available from context." ]
       ] )
     ] [
       fhir:code [ fhir:v "CodeSystem.contact" ] ;
       fhir:display [ fhir:v "contact" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "CodeSystem.contact" ] ;
         fhir:display [ fhir:v "CodeSystem.contact" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `CodeSystem.contact` is mapped to FHIR R4 element `CodeSystem.contact` as `Equivalent`.\nMay be a web site, an email address, a telephone number, etc.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
