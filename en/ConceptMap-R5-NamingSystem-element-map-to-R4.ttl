  fhir:target [
     a fhir:Uri ;
     fhir:v "http://hl7.org/fhir/4.0"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/4.0>
  ] ; # 
  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/NamingSystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/NamingSystem>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/NamingSystem"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/NamingSystem>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "NamingSystem.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.meta" ] ;
         fhir:display [ fhir:v "NamingSystem.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.meta` is mapped to FHIR R4 element `NamingSystem.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.implicitRules" ] ;
         fhir:display [ fhir:v "NamingSystem.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.implicitRules` is mapped to FHIR R4 element `NamingSystem.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.language" ] ;
         fhir:display [ fhir:v "NamingSystem.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.language` is mapped to FHIR R4 element `NamingSystem.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.text" ] ;
         fhir:display [ fhir:v "NamingSystem.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.text` is mapped to FHIR R4 element `NamingSystem.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.contained" ] ;
         fhir:display [ fhir:v "NamingSystem.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.contained` is mapped to FHIR R4 element `NamingSystem.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.name" ] ;
       fhir:display [ fhir:v "name" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.name" ] ;
         fhir:display [ fhir:v "NamingSystem.name" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.name` is mapped to FHIR R4 element `NamingSystem.name` as `Equivalent`.\nThe name is not expected to be globally unique. The name should be a simple alphanumeric type name to ensure that it is machine-processing friendly.The\"symbolic name\" for an OID would be captured as an extension." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.status" ] ;
         fhir:display [ fhir:v "NamingSystem.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.status` is mapped to FHIR R4 element `NamingSystem.status` as `Equivalent`.\nAllows filtering of naming systems that are appropriate for use versus not.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.kind" ] ;
       fhir:display [ fhir:v "kind" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.kind" ] ;
         fhir:display [ fhir:v "NamingSystem.kind" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.kind` is mapped to FHIR R4 element `NamingSystem.kind` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.date" ] ;
       fhir:display [ fhir:v "date" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.date" ] ;
         fhir:display [ fhir:v "NamingSystem.date" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.date` is mapped to FHIR R4 element `NamingSystem.date` as `Equivalent`.\nThe date is often not tracked until the resource is published, but may be present on draft content. Note that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the naming system. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.publisher" ] ;
       fhir:display [ fhir:v "publisher" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.publisher" ] ;
         fhir:display [ fhir:v "NamingSystem.publisher" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.publisher` is mapped to FHIR R4 element `NamingSystem.publisher` as `Equivalent`.\nUsually an organization but may be an individual. The publisher (or steward) of the naming system is the organization or individual primarily responsible for the maintenance and upkeep of the naming system. This is not necessarily the same individual or organization that developed and initially authored the content. The publisher is the primary point of contact for questions or issues with the naming system. This item SHOULD be populated unless the information is available from context." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.contact" ] ;
       fhir:display [ fhir:v "contact" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.contact" ] ;
         fhir:display [ fhir:v "NamingSystem.contact" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.contact` is mapped to FHIR R4 element `NamingSystem.contact` as `Equivalent`.\nMay be a web site, an email address, a telephone number, etc.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.responsible" ] ;
       fhir:display [ fhir:v "responsible" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.responsible" ] ;
         fhir:display [ fhir:v "NamingSystem.responsible" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.responsible` is mapped to FHIR R4 element `NamingSystem.responsible` as `Equivalent`.\nThis is the primary organization.  Responsibility for some aspects of a namespace may be delegated." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.type" ] ;
       fhir:display [ fhir:v "type" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.type" ] ;
         fhir:display [ fhir:v "NamingSystem.type" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.type` is mapped to FHIR R4 element `NamingSystem.type` as `Equivalent`.\nThis will most commonly be used for identifier namespaces, but categories could potentially be useful for code systems and authorities as well." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.description" ] ;
       fhir:display [ fhir:v "description" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.description" ] ;
         fhir:display [ fhir:v "NamingSystem.description" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.description` is mapped to FHIR R4 element `NamingSystem.description` as `Equivalent`.\nThis description can be used to capture details such as comments about misuse, instructions for clinical use and interpretation, literature references, examples from the paper world, etc. It is not a rendering of the naming system as conveyed in the 'text' field of the resource itself. This item SHOULD be populated unless the information is available from context (e.g. the language of the naming system is presumed to be the predominant language in the place the naming system was created)." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.useContext" ] ;
       fhir:display [ fhir:v "useContext" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.useContext" ] ;
         fhir:display [ fhir:v "NamingSystem.useContext" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.useContext` is mapped to FHIR R4 element `NamingSystem.useContext` as `Equivalent`.\nWhen multiple useContexts are specified, there is no expectation that all or any of the contexts apply." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.jurisdiction" ] ;
       fhir:display [ fhir:v "jurisdiction" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.jurisdiction" ] ;
         fhir:display [ fhir:v "NamingSystem.jurisdiction" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.jurisdiction` is mapped to FHIR R4 element `NamingSystem.jurisdiction` as `Equivalent`.\nElement `NamingSystem.jurisdiction` has been flagged as deprecated.\nIt may be possible for the naming system to be used in jurisdictions other than those for which it was originally designed or intended.\n\nDEPRECATION NOTE: For consistency, implementations are encouraged to migrate to using the new 'jurisdiction' code in the useContext element.  (I.e. useContext.code indicating http://terminology.hl7.org/CodeSystem/usage-context-type#jurisdiction and useContext.valueCodeableConcept indicating the jurisdiction.)" ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.usage" ] ;
       fhir:display [ fhir:v "usage" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.usage" ] ;
         fhir:display [ fhir:v "NamingSystem.usage" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.usage` is mapped to FHIR R4 element `NamingSystem.usage` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.uniqueId" ] ;
       fhir:display [ fhir:v "uniqueId" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.uniqueId" ] ;
         fhir:display [ fhir:v "NamingSystem.uniqueId" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.uniqueId` is mapped to FHIR R4 element `NamingSystem.uniqueId` as `Equivalent`.\nMultiple identifiers may exist, either due to duplicate registration, regional rules, needs of different communication technologies, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.uniqueId.type" ] ;
       fhir:display [ fhir:v "type" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.uniqueId.type" ] ;
         fhir:display [ fhir:v "NamingSystem.uniqueId.type" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.uniqueId.type` is mapped to FHIR R4 element `NamingSystem.uniqueId.type` as `RelatedTo`.\nThe mappings for `NamingSystem.uniqueId.type` do not allow expression of the necessary codes, per the bindings on the source and target.\nDifferent identifier types may be used in different types of communications (OIDs for v3, URIs for FHIR, etc.).  Other includes RUIDs from v3, standard v2 code name strings, etc. Preferred identifiers for the same identifier type SHOULD NOT overlap by period." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.uniqueId.value" ] ;
       fhir:display [ fhir:v "value" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.uniqueId.value" ] ;
         fhir:display [ fhir:v "NamingSystem.uniqueId.value" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.uniqueId.value` is mapped to FHIR R4 element `NamingSystem.uniqueId.value` as `Equivalent`.\nIf the value is a URI intended for use as FHIR system identifier, the URI should not contain \"\\\" or \"?\" or \",\" since this makes escaping very difficult." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.uniqueId.preferred" ] ;
       fhir:display [ fhir:v "preferred" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.uniqueId.preferred" ] ;
         fhir:display [ fhir:v "NamingSystem.uniqueId.preferred" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.uniqueId.preferred` is mapped to FHIR R4 element `NamingSystem.uniqueId.preferred` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.uniqueId.comment" ] ;
       fhir:display [ fhir:v "comment" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.uniqueId.comment" ] ;
         fhir:display [ fhir:v "NamingSystem.uniqueId.comment" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NamingSystem.uniqueId.comment` is mapped to FHIR R4 element `NamingSystem.uniqueId.comment` as `Equivalent`.\ne.g. \"must be used in Germany\" or \"was initially published in error with this value\"." ]
       ] )
     ] [
       fhir:code [ fhir:v "NamingSystem.uniqueId.period" ] ;
       fhir:display [ fhir:v "period" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NamingSystem.uniqueId.period" ] ;
         fhir:display [ fhir:v "NamingSystem.uniqueId.period" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
