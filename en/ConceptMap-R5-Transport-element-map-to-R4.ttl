         fhir:comment [ fhir:v "Element `Transport.status` is not mapped to FHIR R4, since FHIR R5 `Transport` is not mapped.\nElement `Transport.status` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Transport.statusReason" ] ;
       fhir:display [ fhir:v "statusReason" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Transport.statusReason" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Transport.statusReason` is not mapped to FHIR R4, since FHIR R5 `Transport` is not mapped.\nElement `Transport.statusReason` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThis applies to the current status.  Look at the history of the transport to see reasons for past statuses." ]
       ] )
     ] [
       fhir:code [ fhir:v "Transport.intent" ] ;
       fhir:display [ fhir:v "intent" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Transport.intent" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Transport.intent` is not mapped to FHIR R4, since FHIR R5 `Transport` is not mapped.\nElement `Transport.intent` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThis element is immutable.  Proposed transports, planned transports, etc. must be distinct instances.\n\nIn most cases, Transports will have an intent of \"order\"." ]
       ] )
     ] [
