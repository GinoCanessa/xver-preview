       fhir:l <http://hl7.org/fhir/StructureDefinition/DiagnosticReport>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "DiagnosticReport.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "DiagnosticReport.meta" ] ;
         fhir:display [ fhir:v "DiagnosticReport.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `DiagnosticReport.meta` is mapped to FHIR R4 element `DiagnosticReport.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "DiagnosticReport.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "DiagnosticReport.implicitRules" ] ;
         fhir:display [ fhir:v "DiagnosticReport.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `DiagnosticReport.implicitRules` is mapped to FHIR R4 element `DiagnosticReport.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "DiagnosticReport.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "DiagnosticReport.language" ] ;
         fhir:display [ fhir:v "DiagnosticReport.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `DiagnosticReport.language` is mapped to FHIR R4 element `DiagnosticReport.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "DiagnosticReport.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "DiagnosticReport.text" ] ;
