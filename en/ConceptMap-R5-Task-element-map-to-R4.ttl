  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Task"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Task>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Task"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Task>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "Task.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.meta" ] ;
         fhir:display [ fhir:v "Task.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.meta` is mapped to FHIR R4 element `Task.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.implicitRules" ] ;
         fhir:display [ fhir:v "Task.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.implicitRules` is mapped to FHIR R4 element `Task.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.language" ] ;
         fhir:display [ fhir:v "Task.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.language` is mapped to FHIR R4 element `Task.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.text" ] ;
         fhir:display [ fhir:v "Task.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.text` is mapped to FHIR R4 element `Task.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.contained" ] ;
         fhir:display [ fhir:v "Task.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.contained` is mapped to FHIR R4 element `Task.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.identifier" ] ;
         fhir:display [ fhir:v "Task.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.identifier` is mapped to FHIR R4 element `Task.identifier` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.instantiatesCanonical" ] ;
       fhir:display [ fhir:v "instantiatesCanonical" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.instantiatesCanonical" ] ;
         fhir:display [ fhir:v "Task.instantiatesCanonical" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.instantiatesCanonical` is mapped to FHIR R4 element `Task.instantiatesCanonical` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.instantiatesUri" ] ;
       fhir:display [ fhir:v "instantiatesUri" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.instantiatesUri" ] ;
         fhir:display [ fhir:v "Task.instantiatesUri" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.instantiatesUri` is mapped to FHIR R4 element `Task.instantiatesUri` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.basedOn" ] ;
       fhir:display [ fhir:v "basedOn" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.basedOn" ] ;
         fhir:display [ fhir:v "Task.basedOn" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.basedOn` is mapped to FHIR R4 element `Task.basedOn` as `Equivalent`.\nTask.basedOn is never the same as Task.focus.  Task.basedOn will typically not be present for 'please fulfill' Tasks as a distinct authorization is rarely needed to request fulfillment.  If the Task is seeking fulfillment of an order, the order to be fulfilled is always communicated using `focus`, never basedOn.  However, authorization may be needed to perform other types of Task actions.  As an example of when both would be present, a Task seeking suspension of a prescription might have a Task.basedOn pointing to the ServiceRequest ordering surgery (which is the driver for suspending the MedicationRequest - which would be the Task.focus)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.groupIdentifier" ] ;
       fhir:display [ fhir:v "groupIdentifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.groupIdentifier" ] ;
         fhir:display [ fhir:v "Task.groupIdentifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.groupIdentifier` is mapped to FHIR R4 element `Task.groupIdentifier` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.partOf" ] ;
       fhir:display [ fhir:v "partOf" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.partOf" ] ;
         fhir:display [ fhir:v "Task.partOf" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.partOf` is mapped to FHIR R4 element `Task.partOf` as `Equivalent`.\nThis should usually be 0..1." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.status" ] ;
         fhir:display [ fhir:v "Task.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.status` is mapped to FHIR R4 element `Task.status` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.statusReason" ] ;
       fhir:display [ fhir:v "statusReason" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.statusReason" ] ;
         fhir:display [ fhir:v "Task.statusReason" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Task.statusReason` is mapped to FHIR R4 element `Task.statusReason` as `SourceIsBroaderThanTarget`.\nThe mappings for `Task.statusReason` do not cover the following types: CodeableReference.\nThe mappings for `Task.statusReason` do not cover the following types based on type expansion: reference.\nThis applies to the current status.  Look at the history of the task to see reasons for past statuses." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.businessStatus" ] ;
       fhir:display [ fhir:v "businessStatus" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.businessStatus" ] ;
         fhir:display [ fhir:v "Task.businessStatus" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.businessStatus` is mapped to FHIR R4 element `Task.businessStatus` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.intent" ] ;
       fhir:display [ fhir:v "intent" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.intent" ] ;
         fhir:display [ fhir:v "Task.intent" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Task.intent` is mapped to FHIR R4 element `Task.intent` as `Equivalent`.\nThis element is immutable.  Proposed tasks, planned tasks, etc. must be distinct instances.\n\nIn most cases, Tasks will have an intent of \"order\"." ]
       ] )
     ] [
       fhir:code [ fhir:v "Task.priority" ] ;
       fhir:display [ fhir:v "priority" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Task.priority" ] ;
