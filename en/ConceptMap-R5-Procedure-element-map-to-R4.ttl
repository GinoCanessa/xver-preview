  fhir:source [
     a fhir:Canonical ;
     fhir:v "http://hl7.org/fhir/5.0"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/5.0>
  ] ; # 
  fhir:target [
     a fhir:Uri ;
     fhir:v "http://hl7.org/fhir/4.0"^^xsd:anyURI ;
     fhir:l <http://hl7.org/fhir/4.0>
  ] ; # 
  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Procedure"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Procedure>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Procedure"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Procedure>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "Procedure.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.meta" ] ;
         fhir:display [ fhir:v "Procedure.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.meta` is mapped to FHIR R4 element `Procedure.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.implicitRules" ] ;
         fhir:display [ fhir:v "Procedure.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.implicitRules` is mapped to FHIR R4 element `Procedure.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.language" ] ;
         fhir:display [ fhir:v "Procedure.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.language` is mapped to FHIR R4 element `Procedure.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.text" ] ;
         fhir:display [ fhir:v "Procedure.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.text` is mapped to FHIR R4 element `Procedure.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.contained" ] ;
         fhir:display [ fhir:v "Procedure.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.contained` is mapped to FHIR R4 element `Procedure.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.identifier" ] ;
         fhir:display [ fhir:v "Procedure.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.identifier` is mapped to FHIR R4 element `Procedure.identifier` as `Equivalent`.\nThis is a business identifier, not a resource identifier (see [discussion](https://hl7.org/fhir/resource.htm#identifiers)).  It is best practice for the identifier to only appear on a single resource instance, however business practices may occasionally dictate that multiple resource instances with the same identifier can exist - possibly even with different resource types.  For example, multiple Patient and Person resource instances might share the same social insurance number." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.instantiatesCanonical" ] ;
       fhir:display [ fhir:v "instantiatesCanonical" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.instantiatesCanonical" ] ;
         fhir:display [ fhir:v "Procedure.instantiatesCanonical" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.instantiatesCanonical` is mapped to FHIR R4 element `Procedure.instantiatesCanonical` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.instantiatesUri" ] ;
       fhir:display [ fhir:v "instantiatesUri" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.instantiatesUri" ] ;
         fhir:display [ fhir:v "Procedure.instantiatesUri" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.instantiatesUri` is mapped to FHIR R4 element `Procedure.instantiatesUri` as `Equivalent`.\nThis might be an HTML page, PDF, etc. or could just be a non-resolvable URI identifier." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.basedOn" ] ;
       fhir:display [ fhir:v "basedOn" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.basedOn" ] ;
         fhir:display [ fhir:v "Procedure.basedOn" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.basedOn` is mapped to FHIR R4 element `Procedure.basedOn` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.partOf" ] ;
       fhir:display [ fhir:v "partOf" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.partOf" ] ;
         fhir:display [ fhir:v "Procedure.partOf" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.partOf` is mapped to FHIR R4 element `Procedure.partOf` as `Equivalent`.\nThe MedicationAdministration resource has a partOf reference to Procedure, but this is not a circular reference.   For example, the anesthesia MedicationAdministration is part of the surgical Procedure (MedicationAdministration.partOf = Procedure).  For example, the procedure to insert the IV port for an IV medication administration is part of the medication administration (Procedure.partOf = MedicationAdministration)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.status" ] ;
         fhir:display [ fhir:v "Procedure.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.status` is mapped to FHIR R4 element `Procedure.status` as `Equivalent`.\nThe \"unknown\" code is not to be used to convey other statuses.  The \"unknown\" code should be used when one of the statuses applies, but the authoring system doesn't know the current state of the procedure.\n\nThis element is labeled as a modifier because the status contains codes that mark the resource as not currently valid." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.statusReason" ] ;
       fhir:display [ fhir:v "statusReason" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.statusReason" ] ;
         fhir:display [ fhir:v "Procedure.statusReason" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.statusReason` is mapped to FHIR R4 element `Procedure.statusReason` as `Equivalent`.\nThis is generally only used for \"exception\" statuses such as \"not-done\", \"suspended\" or \"aborted\". The reason for performing the event at all is captured in reasonCode, not here." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.category" ] ;
       fhir:display [ fhir:v "category" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.category" ] ;
         fhir:display [ fhir:v "Procedure.category" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.category` is mapped to FHIR R4 element `Procedure.category` as `SourceIsBroaderThanTarget`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.code" ] ;
       fhir:display [ fhir:v "code" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.code" ] ;
         fhir:display [ fhir:v "Procedure.code" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Procedure.code` is mapped to FHIR R4 element `Procedure.code` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Procedure.subject" ] ;
       fhir:display [ fhir:v "subject" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Procedure.subject" ] ;
         fhir:display [ fhir:v "Procedure.subject" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Procedure.subject` is mapped to FHIR R4 element `Procedure.subject` as `SourceIsBroaderThanTarget`.\nThe standard extension `alternate-reference` has been mapped as the representation of FHIR R5 element `Procedure.subject` with unmapped reference targets: Device, Location, Organization, Practitioner." ]
       ] )
     ] [
