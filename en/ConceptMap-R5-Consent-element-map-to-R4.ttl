         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Consent.category` is mapped to FHIR R4 element `Consent.category` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Consent.subject" ] ;
