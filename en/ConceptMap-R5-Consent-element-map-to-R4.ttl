       ] )
     ] [
       fhir:code [ fhir:v "Consent.grantee" ] ;
       fhir:display [ fhir:v "grantee" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Consent.performer" ] ;
         fhir:display [ fhir:v "Consent.performer" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Consent.grantee` is mapped to FHIR R4 element `Consent.performer` as `SourceIsBroaderThanTarget`.\nThe standard extension `alternate-reference` has been mapped as the representation of FHIR R5 element `Consent.grantee` with unmapped reference targets: CareTeam, HealthcareService.\nIn a fully computable consent, both grantee and grantor  will be listed as actors within the consent. The Grantee and Grantor elements are for ease of search only." ]
       ] )
     ] [
       fhir:code [ fhir:v "Consent.sourceAttachment" ] ;
       fhir:display [ fhir:v "sourceAttachment" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Consent.source[x]" ] ;
         fhir:display [ fhir:v "Consent.source[x]" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Consent.sourceAttachment` is mapped to FHIR R4 element `Consent.source[x]` as `SourceIsBroaderThanTarget`.\nThe target context `Consent.source[x]` is a choice-type element and cannot directly hold extensions. The context is moved up to parent element `Consent`.\nThe source can be contained inline (Attachment), referenced directly (Consent), referenced in a consent repository (DocumentReference), or simply by an identifier (Identifier), e.g. a CDA document id." ]
       ] )
     ] [
       fhir:code [ fhir:v "Consent.sourceReference" ] ;
       fhir:display [ fhir:v "sourceReference" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Consent.source[x]" ] ;
         fhir:display [ fhir:v "Consent.source[x]" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Consent.sourceReference` is mapped to FHIR R4 element `Consent.source[x]` as `SourceIsBroaderThanTarget`.\nThe standard extension `alternate-reference` has been mapped as the representation of FHIR R5 element `Consent.sourceReference` with unmapped reference targets: DocumentReference.\nSource element `Consent.sourceReference` has unmapped reference types. While the target element `Consent.source[x]` is a choice type and does not allow extensions, the `alternate-reference` extension can be applied to Reference values within it.\nThe source can be contained inline (Attachment), referenced directly (Consent), referenced in a consent repository (DocumentReference), or simply by an identifier (Identifier), e.g. a CDA document id." ]
       ] )
