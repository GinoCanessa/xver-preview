         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Observation.issued` is mapped to FHIR R4 element `Observation.issued` as `Equivalent`.\nFor Observations that don't require review and verification, it may be the same as the [`lastUpdated` ](https://hl7.org/fhir/resource-definiti.html#Meta.lastUpdated) time of the resource itself.  For Observations that do require review and verification for certain updates, it might not be the same as the `lastUpdated` time of the resource itself due to a non-clinically significant update that doesn't require the new version to be reviewed and verified again." ]
       ] )
     ] [
