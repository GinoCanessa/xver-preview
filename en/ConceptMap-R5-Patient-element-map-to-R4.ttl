         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact.gender` is mapped to FHIR R4 element `Patient.contact.gender` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact.organization" ] ;
       fhir:display [ fhir:v "organization" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact.organization" ] ;
         fhir:display [ fhir:v "Patient.contact.organization" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact.organization` is mapped to FHIR R4 element `Patient.contact.organization` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact.period" ] ;
       fhir:display [ fhir:v "period" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact.period" ] ;
         fhir:display [ fhir:v "Patient.contact.period" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact.period` is mapped to FHIR R4 element `Patient.contact.period` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.communication" ] ;
       fhir:display [ fhir:v "communication" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.communication" ] ;
         fhir:display [ fhir:v "Patient.communication" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Patient.communication` is mapped to FHIR R4 element `Patient.communication` as `Equivalent`.\nIf no language is specified, this *implies* that the default local language is spoken.  If you need to convey proficiency for multiple modes, then you need multiple Patient.Communication associations.   For animals, language is not a relevant field, and should be absent from the instance. If the Patient does not speak the default local language, then the Interpreter Required Standard can be used to explicitly declare that an interpreter is required." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.communication.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.communication.language" ] ;
         fhir:display [ fhir:v "Patient.communication.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.communication.language` is mapped to FHIR R4 element `Patient.communication.language` as `Equivalent`.\nThe structure aa-BB with this exact casing is one the most widely used notations for locale. However not all systems actually code this but instead have it as free text. Hence CodeableConcept instead of code as the data type." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.communication.preferred" ] ;
       fhir:display [ fhir:v "preferred" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.communication.preferred" ] ;
         fhir:display [ fhir:v "Patient.communication.preferred" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.communication.preferred` is mapped to FHIR R4 element `Patient.communication.preferred` as `Equivalent`.\nThis language is specifically identified for communicating healthcare information." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.generalPractitioner" ] ;
       fhir:display [ fhir:v "generalPractitioner" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.generalPractitioner" ] ;
         fhir:display [ fhir:v "Patient.generalPractitioner" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.generalPractitioner` is mapped to FHIR R4 element `Patient.generalPractitioner` as `Equivalent`.\nThis may be the primary care provider (in a GP context), or it may be a patient nominated care manager in a community/disability setting, or even organization that will provide people to perform the care provider roles.  It is not to be used to record Care Teams, these should be in a CareTeam resource that may be linked to the CarePlan or EpisodeOfCare resources.\nMultiple GPs may be recorded against the patient for various reasons, such as a student that has his home GP listed along with the GP at university during the school semesters, or a \"fly-in/fly-out\" worker that has the onsite GP also included with his home GP to remain aware of medical issues.\n\nJurisdictions may decide that they can profile this down to 1 if desired, or 1 per type." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.managingOrganization" ] ;
       fhir:display [ fhir:v "managingOrganization" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.managingOrganization" ] ;
         fhir:display [ fhir:v "Patient.managingOrganization" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.managingOrganization` is mapped to FHIR R4 element `Patient.managingOrganization` as `Equivalent`.\nThere is only one managing organization for a specific patient record. Other organizations will have their own Patient record, and may use the Link property to join the records together (or a Person resource which can include confidence ratings for the association)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.link" ] ;
       fhir:display [ fhir:v "link" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.link" ] ;
         fhir:display [ fhir:v "Patient.link" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Patient.link` is mapped to FHIR R4 element `Patient.link` as `Equivalent`.\nThere is no assumption that linked patient records have mutual links." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.link.other" ] ;
       fhir:display [ fhir:v "other" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.link.other" ] ;
         fhir:display [ fhir:v "Patient.link.other" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.link.other` is mapped to FHIR R4 element `Patient.link.other` as `Equivalent`.\nReferencing a RelatedPerson here removes the need to use a Person record to associate a Patient and RelatedPerson as the same individual." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.link.type" ] ;
       fhir:display [ fhir:v "type" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.link.type" ] ;
         fhir:display [ fhir:v "Patient.link.type" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.link.type` is mapped to FHIR R4 element `Patient.link.type` as `Equivalent`." ]
       ] )
     ] )
  ] ) . # 

