         fhir:display [ fhir:v "Patient.name" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.name` is mapped to FHIR R4 element `Patient.name` as `Equivalent`.\nA patient may have multiple names with different uses or applicable periods. For animals, the name is a \"HumanName\" in the sense that is assigned and used by humans and has the same patterns. Animal names may be communicated as given names, and optionally may include a family name." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.telecom" ] ;
       fhir:display [ fhir:v "telecom" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.telecom" ] ;
         fhir:display [ fhir:v "Patient.telecom" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.telecom` is mapped to FHIR R4 element `Patient.telecom` as `Equivalent`.\nA Patient may have multiple ways to be contacted with different uses or applicable periods.  May need to have options for contacting the person urgently and also to help with identification. The address might not go directly to the individual, but may reach another party that is able to proxy for the patient (i.e. home phone, or pet owner's phone)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.gender" ] ;
       fhir:display [ fhir:v "gender" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.gender" ] ;
         fhir:display [ fhir:v "Patient.gender" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.gender` is mapped to FHIR R4 element `Patient.gender` as `Equivalent`.\nThe gender might not match the biological sex as determined by genetics or the individual's preferred identification. Note that for both humans and particularly animals, there are other legitimate possibilities than male and female, though the vast majority of systems and contexts only support male and female.  Systems providing decision support or enforcing business rules should ideally do this on the basis of Observations dealing with the specific sex or gender aspect of interest (anatomical, chromosomal, social, etc.)  However, because these observations are infrequently recorded, defaulting to the administrative gender is common practice.  Where such defaulting occurs, rule enforcement should allow for the variation between administrative and biological, chromosomal and other gender aspects.  For example, an alert about a hysterectomy on a male should be handled as a warning or overridable error, not a \"hard\" error.  See the Patient Gender and Sex section for additional information about communicating patient gender and sex." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.birthDate" ] ;
       fhir:display [ fhir:v "birthDate" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.birthDate" ] ;
         fhir:display [ fhir:v "Patient.birthDate" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.birthDate` is mapped to FHIR R4 element `Patient.birthDate` as `Equivalent`.\nPartial dates are allowed if the specific date of birth is unknown. There is a standard extension \"patient-birthTime\" available that should be used where Time is required (such as in maternity/infant care systems)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.deceased[x]" ] ;
       fhir:display [ fhir:v "deceased[x]" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.deceased[x]" ] ;
         fhir:display [ fhir:v "Patient.deceased[x]" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.deceased[x]` is mapped to FHIR R4 element `Patient.deceased[x]` as `Equivalent`.\nThe target context `Patient.deceased[x]` is a choice-type element and cannot directly hold extensions. The context is moved up to parent element `Patient`.\nIf there's no value in the instance, it means there is no statement on whether or not the individual is deceased. Most systems will interpret the absence of a value as a sign of the person being alive." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.address" ] ;
       fhir:display [ fhir:v "address" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.address" ] ;
         fhir:display [ fhir:v "Patient.address" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.address` is mapped to FHIR R4 element `Patient.address` as `Equivalent`.\nPatient may have multiple addresses with different uses or applicable periods." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.maritalStatus" ] ;
       fhir:display [ fhir:v "maritalStatus" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.maritalStatus" ] ;
         fhir:display [ fhir:v "Patient.maritalStatus" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.maritalStatus` is mapped to FHIR R4 element `Patient.maritalStatus` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.multipleBirth[x]" ] ;
       fhir:display [ fhir:v "multipleBirth[x]" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.multipleBirth[x]" ] ;
         fhir:display [ fhir:v "Patient.multipleBirth[x]" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.multipleBirth[x]` is mapped to FHIR R4 element `Patient.multipleBirth[x]` as `Equivalent`.\nThe target context `Patient.multipleBirth[x]` is a choice-type element and cannot directly hold extensions. The context is moved up to parent element `Patient`.\nWhere the valueInteger is provided, the number is the birth number in the sequence. E.g. The middle birth in triplets would be valueInteger=2 and the third born would have valueInteger=3 If a boolean value was provided for this triplets example, then all 3 patient records would have valueBoolean=true (the ordering is not indicated)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.photo" ] ;
       fhir:display [ fhir:v "photo" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.photo" ] ;
         fhir:display [ fhir:v "Patient.photo" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.photo` is mapped to FHIR R4 element `Patient.photo` as `Equivalent`.\nGuidelines:\n* Use id photos, not clinical photos.\n* Limit dimensions to thumbnail.\n* Keep byte count low to ease resource updates." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact" ] ;
       fhir:display [ fhir:v "contact" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact" ] ;
         fhir:display [ fhir:v "Patient.contact" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact` is mapped to FHIR R4 element `Patient.contact` as `Equivalent`.\nContact covers all kinds of contact parties: family members, business contacts, guardians, caregivers. Not applicable to register pedigree and family ties beyond use of having contact." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact.relationship" ] ;
       fhir:display [ fhir:v "relationship" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact.relationship" ] ;
         fhir:display [ fhir:v "Patient.contact.relationship" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact.relationship` is mapped to FHIR R4 element `Patient.contact.relationship` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact.name" ] ;
       fhir:display [ fhir:v "name" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact.name" ] ;
         fhir:display [ fhir:v "Patient.contact.name" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact.name` is mapped to FHIR R4 element `Patient.contact.name` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact.telecom" ] ;
       fhir:display [ fhir:v "telecom" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact.telecom" ] ;
         fhir:display [ fhir:v "Patient.contact.telecom" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact.telecom` is mapped to FHIR R4 element `Patient.contact.telecom` as `Equivalent`.\nContact may have multiple ways to be contacted with different uses or applicable periods.  May need to have options for contacting the person urgently, and also to help with identification." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact.address" ] ;
       fhir:display [ fhir:v "address" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact.address" ] ;
         fhir:display [ fhir:v "Patient.contact.address" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Patient.contact.address` is mapped to FHIR R4 element `Patient.contact.address` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Patient.contact.gender" ] ;
       fhir:display [ fhir:v "gender" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Patient.contact.gender" ] ;
