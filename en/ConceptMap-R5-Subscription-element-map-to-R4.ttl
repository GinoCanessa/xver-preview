       fhir:code [ fhir:v "Subscription.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Subscription.meta" ] ;
         fhir:display [ fhir:v "Subscription.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Subscription.meta` is mapped to FHIR R4 element `Subscription.meta` as `Equivalent`." ]
       ] )
