     ] )
  ] ) ; # 
  fhir:description [ fhir:v "This ConceptMap represents cross-version mappings for elements from a FHIR R5 ImplementationGuide to FHIR R4."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ;
