  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "R5ImplementationGuideElementMapToR4"] ; # 
  fhir:title [ fhir:v "Cross-version mapping for FHIR R5 ImplementationGuide to FHIR R4 ImplementationGuide"] ; # 
