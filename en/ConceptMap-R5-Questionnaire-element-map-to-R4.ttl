         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Questionnaire.item.answerValueSet` is mapped to FHIR R4 element `Questionnaire.item.answerValueSet` as `Equivalent`.\nLOINC defines many useful value sets for questionnaire responses. See [LOINC Answer Lists](https://terminology.hl7.org/LOINC.html). The value may come from the ElementDefinition referred to by .definition." ]
       ] )
     ] [
       fhir:code [ fhir:v "Questionnaire.item.answerOption" ] ;
       fhir:display [ fhir:v "answerOption" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Questionnaire.item.answerOption" ] ;
