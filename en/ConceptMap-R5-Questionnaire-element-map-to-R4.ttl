       ] )
     ] [
       fhir:code [ fhir:v "Questionnaire.item.prefix" ] ;
       fhir:display [ fhir:v "prefix" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Questionnaire.item.prefix" ] ;
         fhir:display [ fhir:v "Questionnaire.item.prefix" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Questionnaire.item.prefix` is mapped to FHIR R4 element `Questionnaire.item.prefix` as `Equivalent`.\nThese are generally unique within a questionnaire, though this is not guaranteed. Some questionnaires may have multiple questions with the same label with logic to control which gets exposed.  Typically, these won't be used for \"display\" items, though such use is not prohibited.  Systems SHOULD NOT generate their own prefixes if prefixes are defined for any items within a Questionnaire." ]
       ] )
     ] [
       fhir:code [ fhir:v "Questionnaire.item.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Questionnaire.item.text" ] ;
         fhir:display [ fhir:v "Questionnaire.item.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Questionnaire.item.text` is mapped to FHIR R4 element `Questionnaire.item.text` as `Equivalent`.\nWhen using this element to represent the name of a section, use group type item and also make sure to limit the text element to a short string suitable for display as a section heading.  Group item instructions should be included as a display type item within the group." ]
