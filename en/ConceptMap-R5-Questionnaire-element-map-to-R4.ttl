         fhir:comment [ fhir:v "Element `Questionnaire.item.maxLength` is mapped to FHIR R4 element `Questionnaire.item.maxLength` as `Equivalent`.\nFor base64binary, reflects the number of characters representing the encoded data, not the number of bytes of the binary data. The value may come from the ElementDefinition referred to by .definition." ]
       ] )
     ] [
       fhir:code [ fhir:v "Questionnaire.item.answerValueSet" ] ;
       fhir:display [ fhir:v "answerValueSet" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Questionnaire.item.answerValueSet" ] ;
