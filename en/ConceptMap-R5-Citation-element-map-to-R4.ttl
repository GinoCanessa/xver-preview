  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Citation"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Citation>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Basic"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Basic>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "Citation.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Basic.meta" ] ;
         fhir:display [ fhir:v "Basic.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element matches Basic element path `Basic.meta` (`Resource.meta`), use that element instead.\nElement `Citation.meta` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.meta` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Basic.implicitRules" ] ;
         fhir:display [ fhir:v "Basic.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element matches Basic element path `Basic.implicitRules` (`Resource.implicitRules`), use that element instead.\nElement `Citation.implicitRules` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.implicitRules` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Basic.language" ] ;
         fhir:display [ fhir:v "Basic.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element matches Basic element path `Basic.language` (`Resource.language`), use that element instead.\nElement `Citation.language` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.language` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Basic.text" ] ;
         fhir:display [ fhir:v "Basic.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element matches Basic element path `Basic.text` (`DomainResource.text`), use that element instead.\nElement `Citation.text` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.text` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Basic.contained" ] ;
         fhir:display [ fhir:v "Basic.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element matches Basic element path `Basic.contained` (`DomainResource.contained`), use that element instead.\nElement `Citation.contained` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.contained` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Basic.identifier" ] ;
         fhir:display [ fhir:v "Basic.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element matches Basic element path `Basic.identifier` (`Basic.identifier`), use that element instead.\nElement `Citation.identifier` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.identifier` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nUse this element if you need to identify the citation record independently from identifying the cited artifact." ]
       ] )
     ] )
  ] [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Citation"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Citation>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/uv/xver/ImplementationGuide/hl7.fhir.uv.xver-r5.r4"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/uv/xver/ImplementationGuide/hl7.fhir.uv.xver-r5.r4>
     ] ;
     fhir:element ( [
       fhir:code [ fhir:v "Citation.url" ] ;
       fhir:display [ fhir:v "url" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.url" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.url` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.url` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nIn some cases, the resource can no longer be found at the stated url, but the url itself cannot change. Implementations can use the meta.source element to indicate where the current master source of the resource can be found." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.version" ] ;
       fhir:display [ fhir:v "version" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.version" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.version` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.version` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThere may be different citation record instances that have the same identifier but different versions. The version can be appended to the url in a reference to allow a reference to a particular business version of the citation record with the format [url]|[version]. The version SHOULD NOT contain a '#' - see [Business Version](https://hl7.org/fhir/resource.h.html#bv-format)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.versionAlgorithm[x]" ] ;
       fhir:display [ fhir:v "versionAlgorithm[x]" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.versionAlgorithm" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.versionAlgorithm[x]` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.versionAlgorithm[x]` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nIf set as a string, this is a FHIRPath expression that has two additional context variables passed in - %version1 and %version2 and will return a negative number if version1 is newer, a positive number if version2 is newer, and a 0 if the version ordering can't successfully be determined." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.name" ] ;
       fhir:display [ fhir:v "name" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.name" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.name` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.name` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThe name is not expected to be globally unique. The name should be a simple alphanumeric type name to ensure that it is machine-processing friendly." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.title" ] ;
       fhir:display [ fhir:v "title" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.title" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.title` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.title` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThis name does not need to be machine-processing friendly and may contain punctuation, white-space, etc. Use this element if you have a need for naming the citation record for human use, such as a display name for the citation record that is used when selecting citations from a list." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.status" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.status` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.status` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nAllows filtering of summaries that are appropriate for use versus not. Use \"active\" when the citation record is the version for others to actively use, \"draft\" while you are developing the content, and \"retired\" when this record should no longer be used for any purpose.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.experimental" ] ;
       fhir:display [ fhir:v "experimental" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.experimental" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.experimental` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.experimental` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nAllows filtering of citation records that are appropriate for use versus not." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.date" ] ;
       fhir:display [ fhir:v "date" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.date" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.date` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.date` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThe date is often not tracked until the resource is published, but may be present on draft content. Note that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the citation record. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.publisher" ] ;
       fhir:display [ fhir:v "publisher" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.publisher" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.publisher` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.publisher` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nUsually an organization but may be an individual. The publisher (or steward) of the citation record is the organization or individual primarily responsible for the maintenance and upkeep of the citation record. This is not necessarily the same individual or organization that developed and initially authored the content. The publisher is the primary point of contact for questions or issues with the citation record. This item SHOULD be populated unless the information is available from context." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.contact" ] ;
       fhir:display [ fhir:v "contact" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.contact" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.contact` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.contact` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nMay be a web site, an email address, a telephone number, etc.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.description" ] ;
       fhir:display [ fhir:v "description" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.description" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Citation.description` is not mapped to FHIR R4, since FHIR R5 `Citation` is not mapped.\nElement `Citation.description` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element).\nThis description can be used to capture details such as comments about misuse, instructions for clinical use and interpretation, literature references, examples from the paper world, etc. It is not a rendering of the citation as conveyed in the 'text' field of the resource itself. This item SHOULD be populated unless the information is available from context (e.g. the language of the citation is presumed to be the predominant language in the place the citation was created)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Citation.useContext" ] ;
       fhir:display [ fhir:v "useContext" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Citation.useContext" ] ;
