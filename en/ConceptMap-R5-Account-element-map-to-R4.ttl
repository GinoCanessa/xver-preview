         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Account.servicePeriod` is mapped to FHIR R4 element `Account.servicePeriod` as `Equivalent`.\nIt is possible for transactions to be posted outside the service period, as long as the service was provided within the defined service period." ]
       ] )
     ] [
       fhir:code [ fhir:v "Account.coverage" ] ;
       fhir:display [ fhir:v "coverage" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Account.coverage" ] ;
         fhir:display [ fhir:v "Account.coverage" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Account.coverage` is mapped to FHIR R4 element `Account.coverage` as `Equivalent`.\nTypically. this may be some form of insurance, internal charges, or self-pay.\n\nLocal or jurisdictional business rules may determine which coverage covers which types of billable items charged to the account, and in which order.\nWhere the order is important, a local/jurisdictional extension may be defined to specify the order for the type of charge." ]
       ] )
