         fhir:display [ fhir:v "Account.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Account.status` is mapped to FHIR R4 element `Account.status` as `Equivalent`.\nThis element is labeled as a modifier because the status contains the codes inactive and entered-in-error that mark the Account as not currently valid." ]
       ] )
     ] [
