         fhir:code [ fhir:v "Account.subject" ] ;
         fhir:display [ fhir:v "Account.subject" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Account.subject` is mapped to FHIR R4 element `Account.subject` as `Equivalent`.\nAccounts can be applied to non-patients for tracking other non-patient related activities, such as group services (patients not tracked, and costs charged to another body), or might not be allocated." ]
       ] )
     ] [
       fhir:code [ fhir:v "Account.servicePeriod" ] ;
