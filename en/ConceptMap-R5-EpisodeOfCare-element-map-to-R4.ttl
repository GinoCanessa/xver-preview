<http://hl7.org/fhir/uv/xver/ConceptMap/R5-EpisodeOfCare-element-map-to-R4> a fhir:ConceptMap ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "R5-EpisodeOfCare-element-map-to-R4"] ; # 
