       fhir:display [ fhir:v "focus" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Composition.section.focus" ] ;
         fhir:display [ fhir:v "Composition.section.focus" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Composition.section.focus` is mapped to FHIR R4 element `Composition.section.focus` as `Equivalent`.\nTypically, sections in a doument are about the subject of the document, whether that is a  patient, or group of patients, location, or device, or whatever. For some kind of documents, some sections actually contain data about related entities. Typical examples are  a section in a newborn discharge summary concerning the mother, or family history documents, with a section about each family member, though there are many other examples." ]
       ] )
