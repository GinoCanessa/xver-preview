         fhir:display [ fhir:v "Composition.section.section" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Composition.section.section` is mapped to FHIR R4 element `Composition.section.section` as `Equivalent`.\nNested sections are primarily used to help human readers navigate to particular portions of the document." ]
       ] )
     ] )
