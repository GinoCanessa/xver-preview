       fhir:target ( [
         fhir:code [ fhir:v "Composition.section.text" ] ;
         fhir:display [ fhir:v "Composition.section.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Composition.section.text` is mapped to FHIR R4 element `Composition.section.text` as `Equivalent`.\nDocument profiles may define what content should be represented in the narrative to ensure clinical safety." ]
       ] )
