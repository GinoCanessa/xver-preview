         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Composition.event` is mapped to FHIR R4 element `Composition.event` as `Equivalent`.\nThe event needs to be consistent with the type element, though can provide further information if desired." ]
       ] )
     ] [
       fhir:code [ fhir:v "Composition.event.period" ] ;
       fhir:display [ fhir:v "period" ] ;
       fhir:target ( [
