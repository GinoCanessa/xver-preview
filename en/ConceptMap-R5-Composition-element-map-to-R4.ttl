       ] )
     ] [
       fhir:code [ fhir:v "Composition.subject" ] ;
       fhir:display [ fhir:v "subject" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Composition.subject" ] ;
         fhir:display [ fhir:v "Composition.subject" ] ;
