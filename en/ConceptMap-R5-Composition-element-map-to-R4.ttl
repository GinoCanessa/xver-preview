         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Composition.attester` is mapped to FHIR R4 element `Composition.attester` as `Equivalent`.\nOnly list each attester once." ]
       ] )
     ] [
       fhir:code [ fhir:v "Composition.attester.mode" ] ;
       fhir:display [ fhir:v "mode" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Composition.attester.mode" ] ;
         fhir:display [ fhir:v "Composition.attester.mode" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Composition.attester.mode` is mapped to FHIR R4 element `Composition.attester.mode` as `SourceIsBroaderThanTarget`.\nThe mappings for `Composition.attester.mode` do not cover the following types: CodeableConcept.\nThe mappings for `Composition.attester.mode` do not cover the following types based on type expansion: coding." ]
       ] )
     ] [
       fhir:code [ fhir:v "Composition.attester.time" ] ;
       fhir:display [ fhir:v "time" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Composition.attester.time" ] ;
         fhir:display [ fhir:v "Composition.attester.time" ] ;
