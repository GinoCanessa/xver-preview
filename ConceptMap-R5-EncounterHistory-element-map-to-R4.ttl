         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `EncounterHistory.location` is mapped to FHIR R4 element `Encounter.location` as `Equivalent`.\nVirtual encounters can be recorded in the Encounter by specifying a location reference to a location of type \"kind\" such as \"client's home\" and an encounter.class = \"virtual\"." ]
       ] )
