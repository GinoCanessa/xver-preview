       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.date" ] ;
       fhir:display [ fhir:v "date" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.date" ] ;
         fhir:display [ fhir:v "ConceptMap.date" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.date` is mapped to FHIR R4 element `ConceptMap.date` as `Equivalent`.\nThe date is often not tracked until the resource is published, but may be present on draft content. Note that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the concept map. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.publisher" ] ;
       fhir:display [ fhir:v "publisher" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.publisher" ] ;
         fhir:display [ fhir:v "ConceptMap.publisher" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.publisher` is mapped to FHIR R4 element `ConceptMap.publisher` as `Equivalent`.\nUsually an organization but may be an individual. The publisher (or steward) of the concept map is the organization or individual primarily responsible for the maintenance and upkeep of the concept map. This is not necessarily the same individual or organization that developed and initially authored the content. The publisher is the primary point of contact for questions or issues with the concept map. This item SHOULD be populated unless the information is available from context." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.contact" ] ;
       fhir:display [ fhir:v "contact" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.contact" ] ;
         fhir:display [ fhir:v "ConceptMap.contact" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.contact` is mapped to FHIR R4 element `ConceptMap.contact` as `Equivalent`.\nMay be a web site, an email address, a telephone number, etc.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.description" ] ;
       fhir:display [ fhir:v "description" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.description" ] ;
         fhir:display [ fhir:v "ConceptMap.description" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.description` is mapped to FHIR R4 element `ConceptMap.description` as `Equivalent`.\nThe description is not intended to describe the semantics of the concept map. The description should capture its intended use, which is needed for ensuring integrity for its use in models across future changes." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.useContext" ] ;
       fhir:display [ fhir:v "useContext" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.useContext" ] ;
         fhir:display [ fhir:v "ConceptMap.useContext" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.useContext` is mapped to FHIR R4 element `ConceptMap.useContext` as `Equivalent`.\nWhen multiple useContexts are specified, there is no expectation that all or any of the contexts apply." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.jurisdiction" ] ;
