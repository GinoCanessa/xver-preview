     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "trial-use" ;
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-conformance-derivedFrom"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-conformance-derivedFrom>
         ] ;
         fhir:value [
