     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/ConceptMap"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/ConceptMap>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "ConceptMap.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.meta" ] ;
         fhir:display [ fhir:v "ConceptMap.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.meta` is mapped to FHIR R4 element `ConceptMap.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.implicitRules" ] ;
         fhir:display [ fhir:v "ConceptMap.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.implicitRules` is mapped to FHIR R4 element `ConceptMap.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.language" ] ;
         fhir:display [ fhir:v "ConceptMap.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.language` is mapped to FHIR R4 element `ConceptMap.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.text" ] ;
         fhir:display [ fhir:v "ConceptMap.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.text` is mapped to FHIR R4 element `ConceptMap.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.contained" ] ;
         fhir:display [ fhir:v "ConceptMap.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.contained` is mapped to FHIR R4 element `ConceptMap.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.url" ] ;
       fhir:display [ fhir:v "url" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.url" ] ;
         fhir:display [ fhir:v "ConceptMap.url" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.url` is mapped to FHIR R4 element `ConceptMap.url` as `Equivalent`.\nCan be a urn:uuid: or a urn:oid: but real http: addresses are preferred.  Multiple instances may share the same URL if they have a distinct version.\n\nThe determination of when to create a new version of a resource (same url, new version) vs. defining a new artifact is up to the author.  Considerations for making this decision are found in [Technical and Business Versions](https://hl7.org/fhir/resource..html#versions). \n\nIn some cases, the resource can no longer be found at the stated url, but the url itself cannot change. Implementations can use the [meta.source](https://hl7.org/fhir/resou.html#meta) element to indicate where the current master source of the resource can be found." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.identifier" ] ;
         fhir:display [ fhir:v "ConceptMap.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.identifier` is mapped to FHIR R4 element `ConceptMap.identifier` as `SourceIsBroaderThanTarget`.\nTypically, this is used for identifiers that can go in an HL7 V3 II (instance identifier) data type, and can then identify this concept map outside of FHIR, where it is not possible to use the logical URI." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.version" ] ;
       fhir:display [ fhir:v "version" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.version" ] ;
         fhir:display [ fhir:v "ConceptMap.version" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.version` is mapped to FHIR R4 element `ConceptMap.version` as `Equivalent`.\nThere may be different concept map instances that have the same identifier but different versions.  The version can be appended to the url in a reference to allow a reference to a particular business version of the concept map with the format [url]|[version]. The version SHOULD NOT contain a '#' - see [Business Version](https://hl7.org/fhir/resource.h.html#bv-format)." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.name" ] ;
       fhir:display [ fhir:v "name" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.name" ] ;
         fhir:display [ fhir:v "ConceptMap.name" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.name` is mapped to FHIR R4 element `ConceptMap.name` as `Equivalent`.\nThe name is not expected to be globally unique. The name should be a simple alphanumeric type name to ensure that it is machine-processing friendly." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.title" ] ;
       fhir:display [ fhir:v "title" ] ;
       fhir:target ( [
