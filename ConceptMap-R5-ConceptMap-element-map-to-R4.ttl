  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "R5ConceptMapElementMapToR4"] ; # 
  fhir:title [ fhir:v "Cross-version mapping for FHIR R5 ConceptMap to FHIR R4 ConceptMap"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2026-03-04T17:07:47.4077355-06:00"^^xsd:dateTime] ; # 
