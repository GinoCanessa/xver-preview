       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.purpose" ] ;
         fhir:display [ fhir:v "ConceptMap.purpose" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.purpose` is mapped to FHIR R4 element `ConceptMap.purpose` as `Equivalent`.\nThis element does not describe the usage of the concept map. Instead, it provides traceability of ''why'' the resource is either needed or ''why'' it is defined as it is.  This may be used to point to source materials or specifications that drove the structure of this concept map." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.copyright" ] ;
       fhir:display [ fhir:v "copyright" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.copyright" ] ;
         fhir:display [ fhir:v "ConceptMap.copyright" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.copyright` is mapped to FHIR R4 element `ConceptMap.copyright` as `Equivalent`.\nFrequently the copyright differs between the concept map and codes that are included. The copyright statement should clearly differentiate between these when required." ]
       ] )
     ] [
       fhir:code [ fhir:v "ConceptMap.sourceScope[x]" ] ;
       fhir:display [ fhir:v "sourceScope[x]" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "ConceptMap.source[x]" ] ;
         fhir:display [ fhir:v "ConceptMap.source[x]" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `ConceptMap.sourceScope[x]` is mapped to FHIR R4 element `ConceptMap.source[x]` as `Equivalent`.\nThe target context `ConceptMap.source[x]` is a choice-type element and cannot directly hold extensions. The context is moved up to parent element `ConceptMap`.\nShould be a version specific reference. URIs SHOULD be absolute. If there is no sourceScope or targetScope value set, there is no specified context for the map (not recommended).  The sourceScope value set may select codes from either an explicit (standard or local) or implicit code system." ]
       ] )
     ] [
