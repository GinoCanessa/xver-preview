  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/TerminologyCapabilities"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/TerminologyCapabilities>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/TerminologyCapabilities"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/TerminologyCapabilities>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "TerminologyCapabilities.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.meta" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.meta` is mapped to FHIR R4 element `TerminologyCapabilities.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.implicitRules" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.implicitRules` is mapped to FHIR R4 element `TerminologyCapabilities.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.language" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.language` is mapped to FHIR R4 element `TerminologyCapabilities.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.text" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.text` is mapped to FHIR R4 element `TerminologyCapabilities.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.contained" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.contained` is mapped to FHIR R4 element `TerminologyCapabilities.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.url" ] ;
       fhir:display [ fhir:v "url" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.url" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.url" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.url` is mapped to FHIR R4 element `TerminologyCapabilities.url` as `Equivalent`.\nCan be a urn:uuid: or a urn:oid: but real http: addresses are preferred.  Multiple instances may share the same URL if they have a distinct version.\n\nThe determination of when to create a new version of a resource (same url, new version) vs. defining a new artifact is up to the author.  Considerations for making this decision are found in [Technical and Business Versions](https://hl7.org/fhir/resource..html#versions). \n\nIn some cases, the resource can no longer be found at the stated url, but the url itself cannot change. Implementations can use the [meta.source](https://hl7.org/fhir/resou.html#meta) element to indicate where the current master source of the resource can be found." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.version" ] ;
       fhir:display [ fhir:v "version" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.version" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.version" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.version` is mapped to FHIR R4 element `TerminologyCapabilities.version` as `Equivalent`.\nThere may be different terminology capabilities instances that have the same identifier but different versions.  The version can be appended to the url in a reference to allow a reference to a particular business version of the terminology capabilities with the format [url]|[version]. The version SHOULD NOT contain a '#' - see [Business Version](https://hl7.org/fhir/resource.h.html#bv-format)." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.name" ] ;
       fhir:display [ fhir:v "name" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.name" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.name" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.name` is mapped to FHIR R4 element `TerminologyCapabilities.name` as `Equivalent`.\nThe name is not expected to be globally unique. The name should be a simple alphanumeric type name to ensure that it is machine-processing friendly." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.title" ] ;
       fhir:display [ fhir:v "title" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.title" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.title" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.title` is mapped to FHIR R4 element `TerminologyCapabilities.title` as `Equivalent`.\nThis name does not need to be machine-processing friendly and may contain punctuation, white-space, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.status" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.status` is mapped to FHIR R4 element `TerminologyCapabilities.status` as `Equivalent`.\nAllows filtering of terminology capabilitiess that are appropriate for use versus not.This is not intended for use with actual capability statements, but where capability statements are used to describe possible or desired systems.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.experimental" ] ;
       fhir:display [ fhir:v "experimental" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.experimental" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.experimental" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.experimental` is mapped to FHIR R4 element `TerminologyCapabilities.experimental` as `Equivalent`.\nAllows filtering of terminology capabilitiess that are appropriate for use versus not." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.date" ] ;
       fhir:display [ fhir:v "date" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.date" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.date" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.date` is mapped to FHIR R4 element `TerminologyCapabilities.date` as `Equivalent`.\nThe date is often not tracked until the resource is published, but may be present on draft content. Note that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the terminology capabilities. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.publisher" ] ;
       fhir:display [ fhir:v "publisher" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.publisher" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.publisher" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.publisher` is mapped to FHIR R4 element `TerminologyCapabilities.publisher` as `Equivalent`.\nUsually an organization but may be an individual. The publisher (or steward) of the terminology capabilities is the organization or individual primarily responsible for the maintenance and upkeep of the terminology capabilities. This is not necessarily the same individual or organization that developed and initially authored the content. The publisher is the primary point of contact for questions or issues with the terminology capabilities. This item SHOULD be populated unless the information is available from context." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.contact" ] ;
       fhir:display [ fhir:v "contact" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.contact" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.contact" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.contact` is mapped to FHIR R4 element `TerminologyCapabilities.contact` as `Equivalent`.\nMay be a web site, an email address, a telephone number, etc.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.description" ] ;
       fhir:display [ fhir:v "description" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.description" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.description" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.description` is mapped to FHIR R4 element `TerminologyCapabilities.description` as `Equivalent`.\nThis description can be used to capture details such as comments about misuse, instructions for clinical use and interpretation, literature references, examples from the paper world, etc. It is not a rendering of the terminology capabilities as conveyed in the 'text' field of the resource itself. This item SHOULD be populated unless the information is available from context (e.g. the language of the terminology capabilities is presumed to be the predominant language in the place the terminology capabilities was created).This does not need to be populated if the description is adequately implied by the software or implementation details." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.useContext" ] ;
       fhir:display [ fhir:v "useContext" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "TerminologyCapabilities.useContext" ] ;
         fhir:display [ fhir:v "TerminologyCapabilities.useContext" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `TerminologyCapabilities.useContext` is mapped to FHIR R4 element `TerminologyCapabilities.useContext` as `Equivalent`.\nWhen multiple useContexts are specified, there is no expectation that all or any of the contexts apply." ]
       ] )
     ] [
       fhir:code [ fhir:v "TerminologyCapabilities.jurisdiction" ] ;
       fhir:display [ fhir:v "jurisdiction" ] ;
       fhir:target ( [
