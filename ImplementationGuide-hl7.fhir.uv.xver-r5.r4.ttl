         fhir:l <http://hl7.org/fhir/uv/xver/CodeSystem/v3-ParticipationMode> ;
         fhir:reference [ fhir:v "CodeSystem/v3-ParticipationMode" ]
       ] ;
       fhir:name [ fhir:v "ParticipationMode" ] ;
       fhir:description [ fhir:v "A set of codes specifying the modality by which the Entity playing the Role is participating in the Act.\r\n\r\n*Examples:* Physically present, over the telephone, written communication.\r\n\r\n*Rationale:* Particularly for author (originator) participants this is used to specify whether the information represented by the act was initially provided verbally, (hand-)written, or electronically.\r\n\r\n*Open Issue:* There needs to be a reexamination of the hierarchies as there seems to be some muddling between ELECTRONIC and other concepts that involve electronic communication that are in other hierarchies." ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
