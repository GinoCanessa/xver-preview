         fhir:reference [ fhir:v "CodeSystem/v3-ActSite" ]
       ] ;
       fhir:name [ fhir:v "ActSite" ] ;
       fhir:description [ fhir:v "An anatomical location on an organism which can be the focus of an act." ]
     ] [
