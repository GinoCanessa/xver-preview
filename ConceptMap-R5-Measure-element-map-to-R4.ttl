  fhir:group ( [
     fhir:source [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Measure"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Measure>
     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Measure"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Measure>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "Measure.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.meta" ] ;
         fhir:display [ fhir:v "Measure.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.meta` is mapped to FHIR R4 element `Measure.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.implicitRules" ] ;
         fhir:display [ fhir:v "Measure.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.implicitRules` is mapped to FHIR R4 element `Measure.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.language" ] ;
         fhir:display [ fhir:v "Measure.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.language` is mapped to FHIR R4 element `Measure.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.text" ] ;
         fhir:display [ fhir:v "Measure.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.text` is mapped to FHIR R4 element `Measure.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.contained" ] ;
         fhir:display [ fhir:v "Measure.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.contained` is mapped to FHIR R4 element `Measure.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.url" ] ;
       fhir:display [ fhir:v "url" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.url" ] ;
         fhir:display [ fhir:v "Measure.url" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.url` is mapped to FHIR R4 element `Measure.url` as `Equivalent`.\nCan be a urn:uuid: or a urn:oid: but real http: addresses are preferred.  Multiple instances may share the same URL if they have a distinct version.\n\nThe determination of when to create a new version of a resource (same url, new version) vs. defining a new artifact is up to the author.  Considerations for making this decision are found in [Technical and Business Versions](https://hl7.org/fhir/resource..html#versions). \n\nIn some cases, the resource can no longer be found at the stated url, but the url itself cannot change. Implementations can use the [meta.source](https://hl7.org/fhir/resou.html#meta) element to indicate where the current master source of the resource can be found." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.identifier" ] ;
         fhir:display [ fhir:v "Measure.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.identifier` is mapped to FHIR R4 element `Measure.identifier` as `Equivalent`.\nTypically, this is used for identifiers that can go in an HL7 V3 II (instance identifier) data type, and can then identify this measure outside of FHIR, where it is not possible to use the logical URI." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.version" ] ;
       fhir:display [ fhir:v "version" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.version" ] ;
         fhir:display [ fhir:v "Measure.version" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.version` is mapped to FHIR R4 element `Measure.version` as `Equivalent`.\nThere may be different measure instances that have the same identifier but different versions.  The version can be appended to the url in a reference to allow a reference to a particular business version of the measure with the format [url]|[version]. The version SHOULD NOT contain a '#' - see [Business Version](https://hl7.org/fhir/resource.h.html#bv-format)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.name" ] ;
       fhir:display [ fhir:v "name" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.name" ] ;
         fhir:display [ fhir:v "Measure.name" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.name` is mapped to FHIR R4 element `Measure.name` as `Equivalent`.\nThe name is not expected to be globally unique. The name should be a simple alphanumeric type name to ensure that it is machine-processing friendly." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.title" ] ;
       fhir:display [ fhir:v "title" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.title" ] ;
         fhir:display [ fhir:v "Measure.title" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.title` is mapped to FHIR R4 element `Measure.title` as `Equivalent`.\nThis name does not need to be machine-processing friendly and may contain punctuation, white-space, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.subtitle" ] ;
       fhir:display [ fhir:v "subtitle" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.subtitle" ] ;
         fhir:display [ fhir:v "Measure.subtitle" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.subtitle` is mapped to FHIR R4 element `Measure.subtitle` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.status" ] ;
         fhir:display [ fhir:v "Measure.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.status` is mapped to FHIR R4 element `Measure.status` as `Equivalent`.\nAllows filtering of measures that are appropriate for use versus not.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.experimental" ] ;
       fhir:display [ fhir:v "experimental" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.experimental" ] ;
         fhir:display [ fhir:v "Measure.experimental" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.experimental` is mapped to FHIR R4 element `Measure.experimental` as `Equivalent`.\nAllows filtering of measures that are appropriate for use versus not." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.subject[x]" ] ;
       fhir:display [ fhir:v "subject[x]" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.subject[x]" ] ;
         fhir:display [ fhir:v "Measure.subject[x]" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.subject[x]` is mapped to FHIR R4 element `Measure.subject[x]` as `Equivalent`.\nThe target context `Measure.subject[x]` is a choice-type element and cannot directly hold extensions. The context is moved up to parent element `Measure`.\nThe subject of the measure is critical in interpreting the criteria definitions, as the logic in the measures is evaluated with respect to a particular subject. This corresponds roughly to the notion of a Compartment in that it limits what content is available based on its relationship to the subject. In CQL, this corresponds to the context declaration." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.date" ] ;
       fhir:display [ fhir:v "date" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.date" ] ;
         fhir:display [ fhir:v "Measure.date" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.date` is mapped to FHIR R4 element `Measure.date` as `Equivalent`.\nThe date is often not tracked until the resource is published, but may be present on draft content. Note that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the measure. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.publisher" ] ;
       fhir:display [ fhir:v "publisher" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.publisher" ] ;
         fhir:display [ fhir:v "Measure.publisher" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.publisher` is mapped to FHIR R4 element `Measure.publisher` as `Equivalent`.\nUsually an organization but may be an individual. The publisher (or steward) of the measure is the organization or individual primarily responsible for the maintenance and upkeep of the measure. This is not necessarily the same individual or organization that developed and initially authored the content. The publisher is the primary point of contact for questions or issues with the measure. This item SHOULD be populated unless the information is available from context." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.contact" ] ;
       fhir:display [ fhir:v "contact" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.contact" ] ;
         fhir:display [ fhir:v "Measure.contact" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.contact` is mapped to FHIR R4 element `Measure.contact` as `Equivalent`.\nMay be a web site, an email address, a telephone number, etc.\n\nSee guidance around (not) making local changes to elements [here](https://hl7.org/fhir/canonicalreso.html#localization)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.description" ] ;
       fhir:display [ fhir:v "description" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.description" ] ;
         fhir:display [ fhir:v "Measure.description" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.description` is mapped to FHIR R4 element `Measure.description` as `Equivalent`.\nThis description can be used to capture details such as comments about misuse, instructions for clinical use and interpretation, literature references, examples from the paper world, etc. It is not a rendering of the measure as conveyed in the 'text' field of the resource itself. This item SHOULD be populated unless the information is available from context (e.g. the language of the measure is presumed to be the predominant language in the place the measure was created)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.useContext" ] ;
       fhir:display [ fhir:v "useContext" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.useContext" ] ;
         fhir:display [ fhir:v "Measure.useContext" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.useContext` is mapped to FHIR R4 element `Measure.useContext` as `Equivalent`.\nWhen multiple useContexts are specified, there is no expectation that all or any of the contexts apply." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.jurisdiction" ] ;
       fhir:display [ fhir:v "jurisdiction" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.jurisdiction" ] ;
         fhir:display [ fhir:v "Measure.jurisdiction" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.jurisdiction` is mapped to FHIR R4 element `Measure.jurisdiction` as `Equivalent`.\nElement `Measure.jurisdiction` has been flagged as deprecated.\nIt may be possible for the measure to be used in jurisdictions other than those for which it was originally designed or intended.\n\nDEPRECATION NOTE: For consistency, implementations are encouraged to migrate to using the new 'jurisdiction' code in the useContext element.  (I.e. useContext.code indicating http://terminology.hl7.org/CodeSystem/usage-context-type#jurisdiction and useContext.valueCodeableConcept indicating the jurisdiction.)" ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.purpose" ] ;
       fhir:display [ fhir:v "purpose" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.purpose" ] ;
         fhir:display [ fhir:v "Measure.purpose" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.purpose` is mapped to FHIR R4 element `Measure.purpose` as `Equivalent`.\nThis element does not describe the usage of the measure. Instead, it provides traceability of ''why'' the resource is either needed or ''why'' it is defined as it is.  This may be used to point to source materials or specifications that drove the structure of this measure." ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.usage" ] ;
       fhir:display [ fhir:v "usage" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Measure.usage" ] ;
         fhir:display [ fhir:v "Measure.usage" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Measure.usage` is mapped to FHIR R4 element `Measure.usage` as `Equivalent`.\nThis metadata element was typically referred to as Guidance in HQMF" ]
       ] )
     ] [
       fhir:code [ fhir:v "Measure.copyright" ] ;
       fhir:display [ fhir:v "copyright" ] ;
       fhir:target ( [
