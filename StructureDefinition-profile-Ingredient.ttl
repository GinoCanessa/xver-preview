         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "Entity. Role, or Act" ]
       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "Act, Entity or Role" ]
       ] )
