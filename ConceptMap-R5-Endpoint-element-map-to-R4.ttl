       ] )
     ] [
       fhir:code [ fhir:v "Endpoint.payload.mimeType" ] ;
       fhir:display [ fhir:v "mimeType" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Endpoint.payloadMimeType" ] ;
