  fhir:name [ fhir:v "R5ContractElementMapToR4"] ; # 
  fhir:title [ fhir:v "Cross-version mapping for FHIR R5 Contract to FHIR R4 Contract"] ; # 
  fhir:status [ fhir:v "active"] ; # 
