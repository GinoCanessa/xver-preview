         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.period` is mapped to FHIR R4 element `MeasureReport.period` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.improvementNotation" ] ;
       fhir:display [ fhir:v "improvementNotation" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.improvementNotation" ] ;
         fhir:display [ fhir:v "MeasureReport.improvementNotation" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.improvementNotation` is mapped to FHIR R4 element `MeasureReport.improvementNotation` as `Equivalent`.\nThis element is typically defined by the measure, but reproduced here to ensure the measure score can be interpreted. The element is labeled as a modifier because it changes the interpretation of the reported measure score. Note also that a MeasureReport instance includes the improvementNotation as defined by the Measure being reported. It is duplicated in the MeasureReport because it is a critical aspect of interpreting the measure score but it is not intended to reflect whether the measure report is an increase or decrease. It helps interpret if the measure score is an increase or decrease, I.e., moving in the direction of the desired outcome." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.group" ] ;
       fhir:display [ fhir:v "group" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.group" ] ;
         fhir:display [ fhir:v "MeasureReport.group" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.group` is mapped to FHIR R4 element `MeasureReport.group` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.group.code" ] ;
       fhir:display [ fhir:v "code" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.group.code" ] ;
         fhir:display [ fhir:v "MeasureReport.group.code" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.group.code` is mapped to FHIR R4 element `MeasureReport.group.code` as `Equivalent`." ]
       ] )
     ] [
