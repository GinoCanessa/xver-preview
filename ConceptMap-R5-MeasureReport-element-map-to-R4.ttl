     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/MeasureReport"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/MeasureReport>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "MeasureReport.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.meta" ] ;
         fhir:display [ fhir:v "MeasureReport.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.meta` is mapped to FHIR R4 element `MeasureReport.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.implicitRules" ] ;
         fhir:display [ fhir:v "MeasureReport.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.implicitRules` is mapped to FHIR R4 element `MeasureReport.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.language" ] ;
         fhir:display [ fhir:v "MeasureReport.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.language` is mapped to FHIR R4 element `MeasureReport.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.text" ] ;
         fhir:display [ fhir:v "MeasureReport.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.text` is mapped to FHIR R4 element `MeasureReport.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.contained" ] ;
         fhir:display [ fhir:v "MeasureReport.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.contained` is mapped to FHIR R4 element `MeasureReport.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.identifier" ] ;
         fhir:display [ fhir:v "MeasureReport.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.identifier` is mapped to FHIR R4 element `MeasureReport.identifier` as `Equivalent`.\nTypically, this is used for identifiers that can go in an HL7 V3 II data type - e.g. to identify this {{title}} outside of FHIR, where the logical URL is not possible to use." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.status" ] ;
         fhir:display [ fhir:v "MeasureReport.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.status` is mapped to FHIR R4 element `MeasureReport.status` as `Equivalent`.\nThis element is labeled as a modifier because the status contains codes that mark the resource as not currently valid." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.type" ] ;
       fhir:display [ fhir:v "type" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.type" ] ;
         fhir:display [ fhir:v "MeasureReport.type" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.type` is mapped to FHIR R4 element `MeasureReport.type` as `Equivalent`.\nData-exchange reports are used only to communicate data-of-interest for a measure. They do not necessarily include all the data for a particular subject or population, but they may." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.measure" ] ;
       fhir:display [ fhir:v "measure" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.measure" ] ;
         fhir:display [ fhir:v "MeasureReport.measure" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.measure` is mapped to FHIR R4 element `MeasureReport.measure` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.subject" ] ;
       fhir:display [ fhir:v "subject" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.subject" ] ;
         fhir:display [ fhir:v "MeasureReport.subject" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.subject` is mapped to FHIR R4 element `MeasureReport.subject` as `SourceIsBroaderThanTarget`.\nThe standard extension `alternate-reference` has been mapped as the representation of FHIR R5 element `MeasureReport.subject` with unmapped reference targets: CareTeam, HealthcareService, Organization." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.date" ] ;
       fhir:display [ fhir:v "date" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.date" ] ;
         fhir:display [ fhir:v "MeasureReport.date" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.date` is mapped to FHIR R4 element `MeasureReport.date` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.reporter" ] ;
       fhir:display [ fhir:v "reporter" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.reporter" ] ;
         fhir:display [ fhir:v "MeasureReport.reporter" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.reporter` is mapped to FHIR R4 element `MeasureReport.reporter` as `SourceIsBroaderThanTarget`.\nThe standard extension `alternate-reference` has been mapped as the representation of FHIR R5 element `MeasureReport.reporter` with unmapped reference targets: Group." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.period" ] ;
       fhir:display [ fhir:v "period" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.period" ] ;
