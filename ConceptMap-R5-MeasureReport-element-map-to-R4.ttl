       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.group.population.subjectResults" ] ;
       fhir:display [ fhir:v "subjectResults" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.group.population.subjectResults" ] ;
         fhir:display [ fhir:v "MeasureReport.group.population.subjectResults" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MeasureReport.group.population.subjectResults` is mapped to FHIR R4 element `MeasureReport.group.population.subjectResults` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.group.measureScore[x]" ] ;
       fhir:display [ fhir:v "measureScore[x]" ] ;
