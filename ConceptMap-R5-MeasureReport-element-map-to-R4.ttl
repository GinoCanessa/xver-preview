       ] )
     ] [
       fhir:code [ fhir:v "MeasureReport.group.population.code" ] ;
       fhir:display [ fhir:v "code" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MeasureReport.group.population.code" ] ;
