     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/NutritionOrder"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/NutritionOrder>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "NutritionOrder.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NutritionOrder.meta" ] ;
         fhir:display [ fhir:v "NutritionOrder.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NutritionOrder.meta` is mapped to FHIR R4 element `NutritionOrder.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "NutritionOrder.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NutritionOrder.implicitRules" ] ;
         fhir:display [ fhir:v "NutritionOrder.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NutritionOrder.implicitRules` is mapped to FHIR R4 element `NutritionOrder.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "NutritionOrder.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NutritionOrder.language" ] ;
         fhir:display [ fhir:v "NutritionOrder.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NutritionOrder.language` is mapped to FHIR R4 element `NutritionOrder.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "NutritionOrder.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NutritionOrder.text" ] ;
         fhir:display [ fhir:v "NutritionOrder.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NutritionOrder.text` is mapped to FHIR R4 element `NutritionOrder.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "NutritionOrder.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NutritionOrder.contained" ] ;
         fhir:display [ fhir:v "NutritionOrder.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NutritionOrder.contained` is mapped to FHIR R4 element `NutritionOrder.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "NutritionOrder.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NutritionOrder.identifier" ] ;
         fhir:display [ fhir:v "NutritionOrder.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `NutritionOrder.identifier` is mapped to FHIR R4 element `NutritionOrder.identifier` as `Equivalent`.\nThe Identifier.type element can be to indicate filler vs. placer if needed.  This is explained in further detail [here](https://hl7.org/fhir/servic.html#notes)." ]
       ] )
     ] [
       fhir:code [ fhir:v "NutritionOrder.instantiatesCanonical" ] ;
       fhir:display [ fhir:v "instantiatesCanonical" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "NutritionOrder.instantiatesCanonical" ] ;
