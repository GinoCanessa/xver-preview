       fhir:code [ fhir:v "MedicationRequest.dispenseRequest.validityPeriod" ] ;
       fhir:display [ fhir:v "validityPeriod" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MedicationRequest.dispenseRequest.validityPeriod" ] ;
