     ] ;
     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/StructureDefinition/Coverage"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/Coverage>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "Coverage.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Coverage.meta" ] ;
         fhir:display [ fhir:v "Coverage.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Coverage.meta` is mapped to FHIR R4 element `Coverage.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Coverage.implicitRules" ] ;
