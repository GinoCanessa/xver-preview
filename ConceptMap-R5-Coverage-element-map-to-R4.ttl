         fhir:code [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Coverage.insurancePlan" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Coverage.insurancePlan` has a context of Coverage based on following the parent source element upwards and mapping to `Coverage`.\nElement `Coverage.insurancePlan` has no mapping targets in FHIR R4. Typically, this is because the element has been added (is a new element)." ]
