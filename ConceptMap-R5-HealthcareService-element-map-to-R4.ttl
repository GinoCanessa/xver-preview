       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.appointmentRequired" ] ;
       fhir:display [ fhir:v "appointmentRequired" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.appointmentRequired" ] ;
         fhir:display [ fhir:v "HealthcareService.appointmentRequired" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.appointmentRequired` is mapped to FHIR R4 element `HealthcareService.appointmentRequired` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.availability" ] ;
       fhir:display [ fhir:v "availability" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.availableTime" ] ;
         fhir:display [ fhir:v "HealthcareService.availableTime" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.availability` is mapped to FHIR R4 element `HealthcareService.availableTime` as `Equivalent`.\nElement `HealthcareService.availability` is mapped to FHIR R4 element `HealthcareService.notAvailable` as `Equivalent`.\nMore detailed availability information may be provided in associated Schedule/Slot resources.\n\nSystems may choose to render availability differently than it is exchanged on the interface. For example, rather than \"Mon, Tue, Wed, Thur, Fri from 9am-12am; Mon, Tue, Wed, Thur, Fri from 1pm-5pm\" as would be implied by two availableTime repetitions, an application could render this information as \"Mon-Fri 9-12am and 1-5pm\".\r\rThe NotAvailableTime(s) included indicate the general days/periods where the service is not available (for things such as public holidays)." ]
       ] [
         fhir:code [ fhir:v "HealthcareService.notAvailable" ] ;
         fhir:display [ fhir:v "HealthcareService.notAvailable" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.availability` is mapped to FHIR R4 element `HealthcareService.availableTime` as `Equivalent`.\nElement `HealthcareService.availability` is mapped to FHIR R4 element `HealthcareService.notAvailable` as `Equivalent`.\nMore detailed availability information may be provided in associated Schedule/Slot resources.\n\nSystems may choose to render availability differently than it is exchanged on the interface. For example, rather than \"Mon, Tue, Wed, Thur, Fri from 9am-12am; Mon, Tue, Wed, Thur, Fri from 1pm-5pm\" as would be implied by two availableTime repetitions, an application could render this information as \"Mon-Fri 9-12am and 1-5pm\".\r\rThe NotAvailableTime(s) included indicate the general days/periods where the service is not available (for things such as public holidays)." ]
       ] )
     ] [
