     fhir:sourceVersion [ fhir:v "5.0.0" ] ;
     fhir:target [
       fhir:v "http://hl7.org/fhir/uv/xver/ImplementationGuide/hl7.fhir.uv.xver-r5.r4"^^xsd:anyURI ;
