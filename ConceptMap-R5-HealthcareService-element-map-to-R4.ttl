         fhir:display [ fhir:v "HealthcareService.characteristic" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.characteristic` is mapped to FHIR R4 element `HealthcareService.characteristic` as `Equivalent`.\nThese could be such things as is wheelchair accessible." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.communication" ] ;
       fhir:display [ fhir:v "communication" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.communication" ] ;
         fhir:display [ fhir:v "HealthcareService.communication" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.communication` is mapped to FHIR R4 element `HealthcareService.communication` as `Equivalent`.\nWhen using this property it indicates that the service is available with this language, it is not derived from the practitioners, and not all are required to use this language, just that this language is available while scheduling." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.referralMethod" ] ;
       fhir:display [ fhir:v "referralMethod" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.referralMethod" ] ;
         fhir:display [ fhir:v "HealthcareService.referralMethod" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
