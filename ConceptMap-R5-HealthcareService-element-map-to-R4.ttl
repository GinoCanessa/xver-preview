       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.coverageArea" ] ;
       fhir:display [ fhir:v "coverageArea" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.coverageArea" ] ;
         fhir:display [ fhir:v "HealthcareService.coverageArea" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.coverageArea` is mapped to FHIR R4 element `HealthcareService.coverageArea` as `Equivalent`.\nThe locations referenced by the coverage area can include both specific locations, including areas, and also conceptual domains too (mode = kind), such as a physical area (tri-state area) and some other attribute (covered by Example Care Organization). These types of Locations are often not managed by any specific organization. This could also include generic locations such as \"in-home\"." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.serviceProvisionCode" ] ;
       fhir:display [ fhir:v "serviceProvisionCode" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.serviceProvisionCode" ] ;
         fhir:display [ fhir:v "HealthcareService.serviceProvisionCode" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.serviceProvisionCode` is mapped to FHIR R4 element `HealthcareService.serviceProvisionCode` as `Equivalent`.\nThe provision means being commissioned by, contractually obliged or financially sourced. Types of costings that may apply to this healthcare service, such if the service may be available for free, some discounts available, or fees apply." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.eligibility" ] ;
       fhir:display [ fhir:v "eligibility" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.eligibility" ] ;
         fhir:display [ fhir:v "HealthcareService.eligibility" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.eligibility` is mapped to FHIR R4 element `HealthcareService.eligibility` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.eligibility.code" ] ;
       fhir:display [ fhir:v "code" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.eligibility.code" ] ;
         fhir:display [ fhir:v "HealthcareService.eligibility.code" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.eligibility.code` is mapped to FHIR R4 element `HealthcareService.eligibility.code` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.eligibility.comment" ] ;
       fhir:display [ fhir:v "comment" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.eligibility.comment" ] ;
         fhir:display [ fhir:v "HealthcareService.eligibility.comment" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.eligibility.comment` is mapped to FHIR R4 element `HealthcareService.eligibility.comment` as `Equivalent`.\nThe description of service eligibility should, in general, not exceed one or two paragraphs. It should be sufficient for a prospective consumer to determine if they are likely to be eligible or not. Where eligibility requirements and conditions are complex, it may simply be noted that an eligibility assessment is required. Where eligibility is determined by an outside source, such as an Act of Parliament, this should be noted, preferably with a reference to a commonly available copy of the source document such as a web page." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.program" ] ;
       fhir:display [ fhir:v "program" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "HealthcareService.program" ] ;
         fhir:display [ fhir:v "HealthcareService.program" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.program` is mapped to FHIR R4 element `HealthcareService.program` as `Equivalent`.\nPrograms are often defined externally to an Organization, commonly by governments; e.g. Home and Community Care Programs, Homeless Program, …." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.characteristic" ] ;
       fhir:display [ fhir:v "characteristic" ] ;
       fhir:target ( [
