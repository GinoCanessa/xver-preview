         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.category` is mapped to FHIR R4 element `HealthcareService.category` as `Equivalent`.\nSelecting a Service Category then determines the list of relevant service types that can be selected in the primary service type." ]
