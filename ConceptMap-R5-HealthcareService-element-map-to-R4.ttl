         fhir:display [ fhir:v "HealthcareService.providedBy" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `HealthcareService.providedBy` is mapped to FHIR R4 element `HealthcareService.providedBy` as `Equivalent`.\nThis property is recommended to be the same as the Location's managingOrganization, and if not provided should be interpreted as such. If the Location does not have a managing Organization, then this property should be populated." ]
       ] )
     ] [
       fhir:code [ fhir:v "HealthcareService.category" ] ;
