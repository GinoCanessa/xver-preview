       fhir:v "http://hl7.org/fhir/StructureDefinition/MessageDefinition"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/MessageDefinition>
     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "MessageDefinition.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MessageDefinition.meta" ] ;
         fhir:display [ fhir:v "MessageDefinition.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MessageDefinition.meta` is mapped to FHIR R4 element `MessageDefinition.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "MessageDefinition.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "MessageDefinition.implicitRules" ] ;
         fhir:display [ fhir:v "MessageDefinition.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `MessageDefinition.implicitRules` is mapped to FHIR R4 element `MessageDefinition.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "MessageDefinition.language" ] ;
