     ] ;
     fhir:targetVersion [ fhir:v "4.0.1" ] ;
     fhir:element ( [
       fhir:code [ fhir:v "Immunization.meta" ] ;
       fhir:display [ fhir:v "meta" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.meta" ] ;
         fhir:display [ fhir:v "Immunization.meta" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.meta` is mapped to FHIR R4 element `Immunization.meta` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.implicitRules" ] ;
       fhir:display [ fhir:v "implicitRules" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.implicitRules" ] ;
         fhir:display [ fhir:v "Immunization.implicitRules" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.implicitRules` is mapped to FHIR R4 element `Immunization.implicitRules` as `Equivalent`.\nAsserting this rule set restricts the content to be only understood by a limited set of trading partners. This inherently limits the usefulness of the data in the long term. However, the existing health eco-system is highly fractured, and not yet ready to define, collect, and exchange data in a generally computable sense. Wherever possible, implementers and/or specification writers should avoid using this element. Often, when used, the URL is a reference to an implementation guide that defines these special rules as part of its narrative along with other profiles, value sets, etc." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.language" ] ;
       fhir:display [ fhir:v "language" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.language" ] ;
         fhir:display [ fhir:v "Immunization.language" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.language` is mapped to FHIR R4 element `Immunization.language` as `Equivalent`.\nLanguage is provided to support indexing and accessibility (typically, services such as text to speech use the language tag). The html language tag in the narrative applies  to the narrative. The language tag on the resource may be used to specify the language of other presentations generated from the data in the resource. Not all the content has to be in the base language. The Resource.language should not be assumed to apply to the narrative automatically. If a language is specified, it should it also be specified on the div element in the html (see rules in HTML5 for information about the relationship between xml:lang and the html lang attribute)." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.text" ] ;
       fhir:display [ fhir:v "text" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.text" ] ;
         fhir:display [ fhir:v "Immunization.text" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.text` is mapped to FHIR R4 element `Immunization.text` as `Equivalent`.\nContained resources do not have a narrative. Resources that are not contained SHOULD have a narrative. In some cases, a resource may only have text with little or no additional discrete data (as long as all minOccurs=1 elements are satisfied).  This may be necessary for data from legacy systems where information is captured as a \"text blob\" or where text is additionally entered raw or narrated and encoded information is added later." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.contained" ] ;
       fhir:display [ fhir:v "contained" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.contained" ] ;
         fhir:display [ fhir:v "Immunization.contained" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.contained` is mapped to FHIR R4 element `Immunization.contained` as `Equivalent`.\nThis should never be done when the content can be identified properly, as once identification is lost, it is extremely difficult (and context dependent) to restore it again. Contained resources may have profiles and tags in their meta elements, but SHALL NOT have security labels." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.identifier" ] ;
       fhir:display [ fhir:v "identifier" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.identifier" ] ;
         fhir:display [ fhir:v "Immunization.identifier" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.identifier` is mapped to FHIR R4 element `Immunization.identifier` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.status" ] ;
       fhir:display [ fhir:v "status" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.status" ] ;
         fhir:display [ fhir:v "Immunization.status" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.status` is mapped to FHIR R4 element `Immunization.status` as `Equivalent`.\nWill generally be set to show that the immunization has been completed or not done.  This element is labeled as a modifier because the status contains codes that mark the resource as not currently valid." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.statusReason" ] ;
       fhir:display [ fhir:v "statusReason" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.statusReason" ] ;
         fhir:display [ fhir:v "Immunization.statusReason" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.statusReason` is mapped to FHIR R4 element `Immunization.statusReason` as `Equivalent`.\nThis is generally only used for the status of \"not-done\". The reason for performing the immunization event is captured in reasonCode, not here." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.vaccineCode" ] ;
       fhir:display [ fhir:v "vaccineCode" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.vaccineCode" ] ;
         fhir:display [ fhir:v "Immunization.vaccineCode" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.vaccineCode` is mapped to FHIR R4 element `Immunization.vaccineCode` as `Equivalent`.\nThe code for the administered vaccine may be reported at various levels of granularity from a very generic code for a general type of vaccine (e.g. the SNOMED or CVX code for the flu vaccine) to a very discrete code for a specific product including the form and packaging (e.g. an NDC code). Because vaccineCode uses the CodeableConcept data type, multiple codes at different levels of granularity may be reported for a single immunization event provided that all codes are appropriate for the same vaccine. For example, both NDC and CVX codes may be provided for a given immunization event by repeating the coding element within vaccineCode." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.manufacturer" ] ;
       fhir:display [ fhir:v "manufacturer" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.manufacturer" ] ;
         fhir:display [ fhir:v "Immunization.manufacturer" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "Element `Immunization.manufacturer` is mapped to FHIR R4 element `Immunization.manufacturer` as `SourceIsBroaderThanTarget`.\nThe mappings for `Immunization.manufacturer` do not cover the following types: CodeableReference.\nThe mappings for `Immunization.manufacturer` do not cover the following types based on type expansion: concept." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.lotNumber" ] ;
       fhir:display [ fhir:v "lotNumber" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.lotNumber" ] ;
         fhir:display [ fhir:v "Immunization.lotNumber" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.lotNumber` is mapped to FHIR R4 element `Immunization.lotNumber` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.expirationDate" ] ;
       fhir:display [ fhir:v "expirationDate" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.expirationDate" ] ;
         fhir:display [ fhir:v "Immunization.expirationDate" ] ;
         fhir:equivalence [ fhir:v "equivalent" ] ;
         fhir:comment [ fhir:v "Element `Immunization.expirationDate` is mapped to FHIR R4 element `Immunization.expirationDate` as `Equivalent`." ]
       ] )
     ] [
       fhir:code [ fhir:v "Immunization.patient" ] ;
       fhir:display [ fhir:v "patient" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "Immunization.patient" ] ;
         fhir:display [ fhir:v "Immunization.patient" ] ;
