       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://www.hl7.org/Special/committees/fiwg" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "This ConceptMap represents cross-version mappings for elements from a FHIR R5 Device to FHIR R4."] ; # 
